@page
@model AccreditationSystem.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div>
            <div class="flex justify-center">
                <div class="h-24 w-24 rounded-full bg-red-100 flex items-center justify-center">
                    <svg class="h-12 w-12 text-red-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m0 0v2m0-2h2m-2 0H9m3-4V8a1 1 0 00-1-1H8a1 1 0 00-1 1v1m4 4a3 3 0 100-6 3 3 0 000 6zm0 0h3m-3 0h-3m3 0v-1" />
                    </svg>
                </div>
            </div>
            <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
                Access Denied
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600">
                You do not have permission to access this resource
            </p>
        </div>
        <div class="rounded-md bg-red-50 p-4">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">
                        Insufficient permissions
                    </h3>
                    <div class="mt-2 text-sm text-red-700">
                        <p>
                            You don't have the necessary permissions to access this page. Please contact your administrator if you believe this is an error.
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <div class="flex items-center justify-center">
            <a href="/" class="mx-2 inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                Back to Home
            </a>

            @if (User.Identity.IsAuthenticated)
            {
                <a href="/Auth/Logout" class="mx-2 inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Sign Out
                </a>
            }
            else
            {
                <a href="/Auth/Login" class="mx-2 inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Sign In
                </a>
            }
        </div>
    </div>
</div>

