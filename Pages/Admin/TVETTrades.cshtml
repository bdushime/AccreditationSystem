            border-top: 3px solid var(--midnight-blue);
        }

            .testimonial-card:hover {
                transform: translateY(-5px);
                box-shadow: var(--shadow-lg);
            }

        .testimonial-quote {
            color: var(--midnight-blue);
            font-size: 1.5rem;
            margin-bottom: 1rem;
