        }

        .testimonial-author {
            display: flex;
            align-items: center;
        }

        .testimonial-avatar {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--light-bg);
            border-radius: 50%;
            color: var(--midnight-blue);
            font-size: 1.5rem;
            margin-right: 1rem;
        }

        .testimonial-name {
            font-size: 1rem;
            font-weight: 600;
            color: var(--midnight-blue);
            margin-bottom: 0.25rem;
        }

        .testimonial-program {
            font-size: 0.875rem;
            color: var(--dark-gray);
            margin-bottom: 0;
        }

        /* Partner Logos */
        .partners-section {
            background-color: var(--white);
        }

        .partner-logo {
            height: 100px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            background-color: var(--light-bg);
            border-radius: var(--border-radius);
            transition: var(--transition);
        }

            .partner-logo i {
                font-size: 2rem;
                color: var(--midnight-blue);
                margin-bottom: 0.5rem;
            }

            .partner-logo span {
                font-weight: 600;
                color: var(--dark-gray);
                font-size: 0.875rem;
            }

            .partner-logo:hover {
                transform: scale(1.05);
                background-color: var(--white);
                box-shadow: var(--shadow);
            }

        /* CTA Section */
        .cta-section {
            background-color: var(--light-bg);
        }

        .cta-card {
            background: linear-gradient(135deg, var(--midnight-blue) 0%, var(--midnight-blue-light) 100%);
            border-radius: var(--border-radius-lg);
            padding: 3rem;
            color: var(--white);
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow);
        }

            .cta-card::before {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 100%;
                height: 100%;
                background-image: url("/images/hero-bg.JPG");
                opacity: 0.3;
            }

        .cta-title {
            font-size: 1.75rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            position: relative;
        }

        .cta-text {
            font-size: 1.125rem;
            opacity: 0.9;
            max-width: 600px;
            margin-bottom: 0;
        }

        /* Modal Styling */
        .modal-header {
            background-color: var(--midnight-blue);
            color: var(--white);
            border-bottom: none;
        }

        .modal-title {
            font-weight: 600;
        }

        .btn-close {
            filter: brightness(0) invert(1);
        }

        .program-modal-content {
            padding: 1rem;
        }

        .program-category-badge {
            background-color: var(--midnight-blue);
            color: var(--white);
            font-weight: 500;
            padding: 0.35rem 0.75rem;
            border-radius: 50px;
            font-size: 0.75rem;
        }

        .program-modal-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
            margin-top: 1rem;
        }

            .program-modal-meta .meta-item {
                display: flex;
                align-items: center;
                color: var(--dark-gray);
            }

                .program-modal-meta .meta-item i {
                    color: var(--midnight-blue);
                    margin-right: 0.5rem;
                }

        .program-description-card,
        .program-requirements-card,
        .program-careers-card {
            background-color: var(--light-bg);
            border-radius: var(--border-radius);
            padding: 1.5rem;
            height: 100%;
        }

        .card-subtitle {
            color: var(--midnight-blue);
            font-weight: 600;
            margin-bottom: 1rem;
            font-size: 1rem;
            display: flex;
            align-items: center;
        }

        .career-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .career-list li {
                margin-bottom: 0.5rem;
                display: flex;
                align-items: center;
            }

                .career-list li i {
                    color: var(--midnight-blue);
                    margin-right: 0.5rem;
                }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 3rem;
            background-color: var(--light-bg);
            border-radius: var(--border-radius);
            margin: 2rem 0;
        }

        .empty-state-icon {
            font-size: 4rem;
            color: var(--medium-gray);
            margin-bottom: 1rem;
        }

        .empty-state-title {
            font-size: 1.5rem;
            color: var(--midnight-blue);
            margin-bottom: 0.5rem;
        }

        .empty-state-text {
            color: var(--dark-gray);
            max-width: 500px;
            margin: 0 auto 1.5rem;
        }

        /* Custom Button Styles */
        .btn-primary {
            background-color: var(--midnight-blue);
            border-color: var(--midnight-blue);
        }

            .btn-primary:hover,
            .btn-primary:focus {
                background-color: var(--midnight-blue-light);
                border-color: var(--midnight-blue-light);
            }

        .btn-outline-primary {
            color: var(--midnight-blue);
            border-color: var(--midnight-blue);
        }

            .btn-outline-primary:hover,
            .btn-outline-primary:focus {
                background-color: var(--midnight-blue);
                border-color: var(--midnight-blue);
                color: var(--white);
            }

        .btn-outline-light:hover,
        .btn-outline-light:focus {
            color: var(--midnight-blue);
            background-color: var(--white);
            border-color: var(--white);
        }
        /* Change these in your CSS */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes pulse {
            0% {
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(25, 25, 112, 0.7);
            }

            70% {
                transform: scale(1.05);
                box-shadow: 0 0 0 10px rgba(25, 25, 112, 0);
            }

            100% {
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(25, 25, 112, 0);
            }
        }

        @@keyframes shimmer {
            0% {
                transform: translate(-100%, -100%) rotate(30deg);
            }

            100% {
                transform: translate(100%, 100%) rotate(30deg);
            }
        }

        /* Responsive Adjustments */
        @@media (max-width: 991.98px) {
            .tvet-hero {
                padding: 4rem 0;
            }

                .tvet-hero .display-4 {
                    font-size: 2.5rem;
                }

            .cta-card {
                padding: 2rem;
            }
        }

        @@media (max-width: 767.98px) {
            .tvet-hero {
                padding: 3rem 0;
            }

                .tvet-hero .display-4 {
                    font-size: 2rem;
                }

            .tvet-stats {
                margin-top: -20px;
            }

            .search-card {
                padding: 1.5rem;
            }
            /* ... rest of your media query CSS ... */
        }

        @@media (max-width: 575.98px) {
            .tvet-hero {
                padding: 2.5rem 0;
            }

                .tvet-hero .display-4 {
                    font-size: 1.75rem;
                }

        .stat-number {
            font-size: 1.5rem;
        }

        .stat-label {
            font-size: 0.875rem;
        }

        .section-title {
            font-size: 1.5rem;
        }

        .program-modal-meta {
            flex-direction: column;
            gap: 0.5rem;
        }

        }
    </style>
}

@section Scripts {
    <script>
        // Wait for the DOM to be fully loaded
        document.addEventListener('DOMContentLoaded', function() {
            // Animate stats counter
            animateStatCounters();

            // Initialize tooltips
            initTooltips();

            // Add smooth scrolling for anchor links
            initSmoothScrolling();

            // Add animation for category cards
            animateCategoryCards();

            // Initialize filter tag functionality
            initFilterTags();
        });

        // Function to animate stat counters
        function animateStatCounters() {
            const statNumbers = document.querySelectorAll('.stat-number');

            statNumbers.forEach(stat => {
                const finalValue = parseInt(stat.textContent.replace(/\D/g, ''));
                const suffix = stat.textContent.replace(/[0-9]/g, '');
                const duration = 2000; // Animation duration in milliseconds
                const frameDuration = 1000 / 60; // 60fps
                const totalFrames = Math.round(duration / frameDuration);
                let frame = 0;

                // Reset the content to start from 0
                stat.textContent = '0' + suffix;

                // Use requestAnimationFrame for smooth animation
                const animate = () => {
                    frame++;
                    const progress = frame / totalFrames;
                    const currentCount = Math.round(finalValue * (progress < 1 ? progress : 1));

                    stat.textContent = currentCount + suffix;

                    if (frame < totalFrames) {
                        requestAnimationFrame(animate);
                    }
                };

                // Start the animation with a slight delay for each stat
                setTimeout(() => {
                    requestAnimationFrame(animate);
                }, 200);
            });
        }

        // Initialize Bootstrap tooltips
        function initTooltips() {
            const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
        }

        // Add smooth scrolling for anchor links
        function initSmoothScrolling() {
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();

                    const targetId = this.getAttribute('href');
                    if (targetId === '#') return; // Skip links with just "#"

                    const targetElement = document.querySelector(targetId);
                    if (targetElement) {
                        // Smooth scroll to the element
                        targetElement.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });

                        // Update URL but without scrolling (modern browsers only)
                        history.pushState(null, null, targetId);
                    }
                });
            });
        }

        // Add staggered animation for category cards
        function animateCategoryCards() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry, index) => {
                    if (entry.isIntersecting) {
                        // Add a staggered delay based on the index
                        setTimeout(() => {
                            entry.target.classList.add('fade-in-up');
                        }, index * 100);

                        // Stop observing after animation
                        observer.unobserve(entry.target);
                    }
                });
            }, {
                threshold: 0.1 // Trigger when at least 10% of the item is visible
            });

            // Observe all category cards
            document.querySelectorAll('.category-card').forEach(card => {
                observer.observe(card);
            });

            // Observe all program cards
            document.querySelectorAll('.program-card').forEach(card => {
                observer.observe(card);
            });
        }

        // Initialize filter tag functionality
        function initFilterTags() {
            // Remove filter tags functionality
            document.querySelectorAll('.filter-remove').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    window.location.href = this.getAttribute('href');
                });
            });

            // Clear all filters
            const clearButton = document.querySelector('.filter-clear');
            if (clearButton) {
                clearButton.addEventListener('click', function(e) {
                    e.preventDefault();
                    window.location.href = this.getAttribute('href');
                });
            }
        }

        // Program modal functionality enhancements
        document.querySelectorAll('[data-bs-toggle="modal"]').forEach(button => {
            button.addEventListener('click', function() {
                const targetModal = document.querySelector(this.getAttribute('data-bs-target'));
                if (targetModal) {
                    // Add animation class when opening modal
                    targetModal.addEventListener('shown.bs.modal', function() {
                        this.querySelectorAll('.program-modal-content > *').forEach((element, index) => {
                            setTimeout(() => {
                                element.classList.add('fade-in');
                            }, index * 100);
                        });
                    }, { once: true });
                }
            });
        });

        // Add accessibility improvements
        function improveAccessibility() {
            // Ensure all interactive elements have appropriate aria attributes
            document.querySelectorAll('button').forEach(button => {
                if (!button.getAttribute('aria-label') && !button.textContent.trim()) {
                    const icon = button.querySelector('i');
                    if (icon) {
                        const iconClass = icon.className;
                        let actionText = 'Button';

                        if (iconClass.includes('search')) actionText = 'Search';
                        else if (iconClass.includes('filter')) actionText = 'Filter';
                        else if (iconClass.includes('close')) actionText = 'Close';
                        else if (iconClass.includes('download')) actionText = 'Download';

                        button.setAttribute('aria-label', actionText);
                    }
                }
            });

            // Ensure all images have alt text
            document.querySelectorAll('img:not([alt])').forEach(img => {
                img.setAttribute('alt', '');
            });
        }

        // Call accessibility improvements
        improveAccessibility();
    </script>
}