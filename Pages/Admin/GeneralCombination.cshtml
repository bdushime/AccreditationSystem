@page
@model AccreditationSystem.Pages.Admin.GeneralCombinationModel
@{
    ViewData["Title"] = "Academic Combinations";
}

<header class="bg-white shadow-md">
    <div class="container mx-auto px-4 py-3">
        <div class="flex justify-between items-center">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <!-- Logo -->
                    <a href="/" class="flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-primary-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 10v6M2 10l10-7 10 7-10 7-10-7v10a8 8 0 1016 0" />
                        </svg>
                        <span class="ml-3 text-xl font-bold text-gray-900">Accreditation</span>
                    </a>
                </div>
                <!-- Navigation -->
                <nav class="hidden md:ml-8 md:flex space-x-6">
                    <a href="/" class="text-primary-700 font-medium">Home</a>
                    @* <a href="/about" class="text-gray-600 hover:text-primary-700 font-medium">About</a> *@
                    @* <a href="/services" class="text-gray-600 hover:text-primary-700 font-medium">Services</a> *@
                    @* <a href="/resources" class="text-gray-600 hover:text-primary-700 font-medium">Resources</a> *@
                    @* <a href="/contact" class="text-gray-600 hover:text-primary-700 font-medium">Contact</a> *@
                </nav>
            </div>
            <!-- Auth Buttons -->
            <div class="flex items-center space-x-3">
                <a href="/Auth/Login" class="px-4 py-2 text-primary-700 font-medium rounded-md border border-primary-600 hover:bg-primary-50 transition duration-300">Login</a>
                <a href="/Auth/Register" class="px-4 py-2 bg-primary-600 text-white font-medium rounded-md hover:bg-primary-700 transition duration-300">Register</a>
            </div>
        </div>
    </div>
</header>

<main class="container mx-auto px-4 py-8">
    <div class="mb-10 text-center">
        <h1 class="text-3xl font-bold text-blue-700 mb-2">Academic Combinations</h1>
        <p class="text-gray-600 max-w-2xl mx-auto">
            Select an academic combination below to proceed with school identification.
            Each combination will provide tailored questions to help assess your institution's capabilities.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Science Combinations -->
        <div class="bg-white rounded-xl shadow-md overflow-hidden border border-blue-100 transition-all hover:shadow-lg">
            <div class="bg-blue-600 px-6 py-4 text-white">
                <h2 class="text-xl font-semibold">Science Stream</h2>
            </div>
            <div class="p-6">
                <ul class="space-y-4">
                    <li>
                        <a href="/Admin/SchoolIdentificationModel?combination=PCM"
                           class="block p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition flex justify-between items-center">
                            <div>
                                <span class="font-medium text-blue-800">PCM</span>
                                <p class="text-sm text-gray-600 mt-1">Physics, Chemistry, Mathematics</p>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/SchoolIdentificationModel?combination=PCB"
                           class="block p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition flex justify-between items-center">
                            <div>
                                <span class="font-medium text-blue-800">PCB</span>
                                <p class="text-sm text-gray-600 mt-1">Physics, Chemistry, Biology</p>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/SchoolIdentificationModel?combination=PCMB"
                           class="block p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition flex justify-between items-center">
                            <div>
                                <span class="font-medium text-blue-800">PCMB</span>
                                <p class="text-sm text-gray-600 mt-1">Physics, Chemistry, Mathematics, Biology</p>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Commerce Combinations -->
        <div class="bg-white rounded-xl shadow-md overflow-hidden border border-blue-100 transition-all hover:shadow-lg">
            <div class="bg-blue-600 px-6 py-4 text-white">
                <h2 class="text-xl font-semibold">Commerce Stream</h2>
            </div>
            <div class="p-6">
                <ul class="space-y-4">
                    <li>
                        <a href="/Admin/SchoolIdentificationModel?combination=Commerce"
                           class="block p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition flex justify-between items-center">
                            <div>
                                <span class="font-medium text-blue-800">Commerce with Mathematics</span>
                                <p class="text-sm text-gray-600 mt-1">Accountancy, Business Studies, Economics, Mathematics</p>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/SchoolIdentificationModel?combination=CommerceStat"
                           class="block p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition flex justify-between items-center">
                            <div>
                                <span class="font-medium text-blue-800">Commerce with Statistics</span>
                                <p class="text-sm text-gray-600 mt-1">Accountancy, Business Studies, Economics, Statistics</p>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/SchoolIdentificationModel?combination=CommerceComp"
                           class="block p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition flex justify-between items-center">
                            <div>
                                <span class="font-medium text-blue-800">Commerce with Computer Science</span>
                                <p class="text-sm text-gray-600 mt-1">Accountancy, Business Studies, Economics, Computer Science</p>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Arts Combinations -->
        <div class="bg-white rounded-xl shadow-md overflow-hidden border border-blue-100 transition-all hover:shadow-lg">
            <div class="bg-blue-600 px-6 py-4 text-white">
                <h2 class="text-xl font-semibold">Arts Stream</h2>
            </div>
            <div class="p-6">
                <ul class="space-y-4">
                    <li>
                        <a href="/Admin/SchoolIdentificationModel?combination=HEP"
                           class="block p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition flex justify-between items-center">
                            <div>
                                <span class="font-medium text-blue-800">HEP</span>
                                <p class="text-sm text-gray-600 mt-1">History, Economics, Political Science</p>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/SchoolIdentificationModel?combination=EPS"
                           class="block p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition flex justify-between items-center">
                            <div>
                                <span class="font-medium text-blue-800">EPS</span>
                                <p class="text-sm text-gray-600 mt-1">Economics, Psychology, Sociology</p>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/SchoolIdentificationModel?combination=LLS"
                           class="block p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition flex justify-between items-center">
                            <div>
                                <span class="font-medium text-blue-800">LLS</span>
                                <p class="text-sm text-gray-600 mt-1">Literature, Language, Sociology</p>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Vocational Combinations -->
        <div class="bg-white rounded-xl shadow-md overflow-hidden border border-blue-100 transition-all hover:shadow-lg">
            <div class="bg-blue-600 px-6 py-4 text-white">
                <h2 class="text-xl font-semibold">Vocational Stream</h2>
            </div>
            <div class="p-6">
                <ul class="space-y-4">
                    <li>
                        <a href="/Admin/SchoolIdentificationModel?combination=IT"
                           class="block p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition flex justify-between items-center">
                            <div>
                                <span class="font-medium text-blue-800">Information Technology</span>
                                <p class="text-sm text-gray-600 mt-1">Computer Science, Web Development, Network Management</p>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/SchoolIdentification?combination=Healthcare"
                           class="block p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition flex justify-between items-center">
                            <div>
                                <span class="font-medium text-blue-800">Healthcare</span>
                                <p class="text-sm text-gray-600 mt-1">Basic Medical Science, Healthcare Administration, Nursing</p>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Specialized Programs -->
        <div class="bg-white rounded-xl shadow-md overflow-hidden border border-blue-100 transition-all hover:shadow-lg">
            <div class="bg-blue-600 px-6 py-4 text-white">
                <h2 class="text-xl font-semibold">Specialized Programs</h2>
            </div>
            <div class="p-6">
                <ul class="space-y-4">
                    <li>
                        <a href="/Admin/SchoolIdentificationModel?combination=IB"
                           class="block p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition flex justify-between items-center">
                            <div>
                                <span class="font-medium text-blue-800">International Baccalaureate</span>
                                <p class="text-sm text-gray-600 mt-1">IB Diploma Program</p>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/SchoolIdentificationModel?combination=STEM"
                           class="block p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition flex justify-between items-center">
                            <div>
                                <span class="font-medium text-blue-800">STEM Program</span>
                                <p class="text-sm text-gray-600 mt-1">Science, Technology, Engineering, Mathematics</p>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Custom Combination -->
        <div class="bg-white rounded-xl shadow-md overflow-hidden border border-blue-100 transition-all hover:shadow-lg">
            <div class="bg-blue-600 px-6 py-4 text-white">
                <h2 class="text-xl font-semibold">Other Combinations</h2>
            </div>
            <div class="p-6">
                <div class="p-4 bg-blue-50 rounded-lg">
                    <h3 class="font-medium text-blue-800 mb-3">Custom Combination</h3>
                    <p class="text-sm text-gray-600 mb-4">If your academic combination is not listed above, you can specify it here:</p>

                    <form action="/Admin/SchoolIdentificationModel" method="get" class="space-y-4">
                        <div>
                            <label for="customCombination" class="block text-sm font-medium text-gray-700 mb-1">Custom Combination Name:</label>
                            <input type="text" id="customCombination" name="combination"
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"
                                   placeholder="e.g., Physics, Computer Science, Mathematics">
                        </div>
                        <button type="submit"
                                class="w-full bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition">
                            Proceed to School Identification
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>