@page
@model AccreditationSystem.Pages.Admin.ConfirmationModelModel
@{
    ViewData["Title"] = "Application Submitted";
}

<div class="container mx-auto px-4 py-16 text-center">
    <div class="bg-white shadow-lg rounded-lg p-8 max-w-lg mx-auto">
        <div class="mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-green-500 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
        </div>

        <h1 class="text-2xl font-bold text-gray-800 mb-4">Application Submitted Successfully!</h1>

        <p class="text-gray-600 mb-8">
            Thank you for submitting your school registration application. 
            Your application has been received and is currently under review.
        </p>

        <p class="text-gray-600 mb-8">
            You will be notified via email about the status of your application.
        </p>

        <div class="mt-8">
            <a href="/" class="px-6 py-2 bg-primary-600 text-white font-medium rounded-md hover:bg-primary-700 transition duration-300">
                Return to Home
            </a>
        </div>
    </div>
</div>
