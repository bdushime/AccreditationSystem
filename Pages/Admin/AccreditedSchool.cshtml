@page
@model AccreditationSystem.Pages.AccreditedSchoolsModel
@{
    ViewData["Title"] = "Accredited Schools";
}

<header class="bg-white shadow-md">
    <div class="container mx-auto px-4 py-3">
        <div class="flex justify-between items-center">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <!-- Logo -->
                    <a href="/" class="flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-primary-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 10v6M2 10l10-7 10 7-10 7-10-7v10a8 8 0 1016 0" />
                        </svg>
                        <span class="ml-3 text-xl font-bold text-gray-900">Accreditation</span>
                    </a>
                </div>
                <!-- Navigation -->
                <nav class="hidden md:ml-8 md:flex space-x-6">
                    <a href="/" class="text-primary-700 font-medium">Home</a>
                    @* <a href="/about" class="text-gray-600 hover:text-primary-700 font-medium">About</a> *@
                    @* <a href="/services" class="text-gray-600 hover:text-primary-700 font-medium">Services</a> *@
                    @* <a href="/resources" class="text-gray-600 hover:text-primary-700 font-medium">Resources</a> *@
                    @* <a href="/contact" class="text-gray-600 hover:text-primary-700 font-medium">Contact</a> *@
                </nav>
            </div>
            <!-- Auth Buttons -->
            <div class="flex items-center space-x-3">
                <a href="/Auth/Login" class="px-4 py-2 text-primary-700 font-medium rounded-md border border-primary-600 hover:bg-primary-50 transition duration-300">Login</a>
                <a href="/Auth/Register" class="px-4 py-2 bg-primary-600 text-white font-medium rounded-md hover:bg-primary-700 transition duration-300">Register</a>
            </div>
        </div>
    </div>
</header>

<div class="bg-gray-50 min-h-screen pb-12">
    <!-- Hero Section -->
    <div class="relative bg-indigo-800 text-white overflow-hidden">
        <div class="absolute inset-0">
            <img src="/images/schools-hero.jpg" alt="Schools Background" class="w-full h-full object-cover opacity-20">
            <div class="absolute inset-0 bg-indigo-900 opacity-75"></div>
        </div>
        <div class="relative max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
            <div class="lg:col-span-8">
                <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">Accredited Schools</h1>
                <p class="mt-4 text-xl max-w-3xl">
                    Browse our directory of accredited educational institutions meeting our standards for excellence.
                </p>
            </div>
        </div>
    </div>
    <!-- Enhanced School Directory UI -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Improved Stats Dashboard -->
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 -mt-16">
            <!-- Total Schools Card with hover effect and shadow -->
            <div class="bg-white relative overflow-hidden shadow-lg rounded-xl transition-all duration-300 hover:shadow-xl hover:translate-y-[-2px] group">
                <div class="absolute inset-0 bg-gradient-to-r from-indigo-500/10 to-indigo-600/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="px-6 py-6 relative">
                    <div class="flex items-center">
                        <div class="bg-indigo-100 rounded-xl p-3.5 shadow-sm">
                            <svg class="h-9 w-9 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                            </svg>
                        </div>
                        <div class="ml-5">
                            <dt class="text-sm font-medium text-gray-500">Total Schools</dt>
                            <dd class="text-3xl font-bold text-gray-900 mt-1">@Model.TotalSchools</dd>
                        </div>
                    </div>
                </div>
                <!-- Decorative bottom bar -->
                <div class="h-1 w-full bg-gradient-to-r from-indigo-500 to-indigo-700"></div>
            </div>

            <!-- General Programs Card with consistent styling -->
            <div class="bg-white relative overflow-hidden shadow-lg rounded-xl transition-all duration-300 hover:shadow-xl hover:translate-y-[-2px] group">
                <div class="absolute inset-0 bg-gradient-to-r from-green-500/10 to-green-600/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="px-6 py-6 relative">
                    <div class="flex items-center">
                        <div class="bg-green-100 rounded-xl p-3.5 shadow-sm">
                            <svg class="h-9 w-9 text-green-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </div>
                        <div class="ml-5">
                            <dt class="text-sm font-medium text-gray-500">General Programs</dt>
                            <dd class="text-3xl font-bold text-gray-900 mt-1">@Model.GeneralSchools</dd>
                        </div>
                    </div>
                </div>
                <div class="h-1 w-full bg-gradient-to-r from-green-500 to-green-700"></div>
            </div>

            <!-- Specialized Programs Card -->
            <div class="bg-white relative overflow-hidden shadow-lg rounded-xl transition-all duration-300 hover:shadow-xl hover:translate-y-[-2px] group">
                <div class="absolute inset-0 bg-gradient-to-r from-amber-500/10 to-amber-600/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="px-6 py-6 relative">
                    <div class="flex items-center">
                        <div class="bg-amber-100 rounded-xl p-3.5 shadow-sm">
                            <svg class="h-9 w-9 text-amber-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                            </svg>
                        </div>
                        <div class="ml-5">
                            <dt class="text-sm font-medium text-gray-500">Specialized</dt>
                            <dd class="text-3xl font-bold text-gray-900 mt-1">@Model.SpecializedSchools</dd>
                        </div>
                    </div>
                </div>
                <div class="h-1 w-full bg-gradient-to-r from-amber-500 to-amber-700"></div>
            </div>

            <!-- New Schools Card -->
            <div class="bg-white relative overflow-hidden shadow-lg rounded-xl transition-all duration-300 hover:shadow-xl hover:translate-y-[-2px] group">
                <div class="absolute inset-0 bg-gradient-to-r from-purple-500/10 to-purple-600/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="px-6 py-6 relative">
                    <div class="flex items-center">
                        <div class="bg-purple-100 rounded-xl p-3.5 shadow-sm">
                            <svg class="h-9 w-9 text-purple-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                            </svg>
                        </div>
                        <div class="ml-5">
                            <dt class="text-sm font-medium text-gray-500">New (30 days)</dt>
                            <dd class="text-3xl font-bold text-gray-900 mt-1">@Model.NewlyAccreditedSchools</dd>
                        </div>
                    </div>
                </div>
                <div class="h-1 w-full bg-gradient-to-r from-purple-500 to-purple-700"></div>
            </div>
        </div>

        <!-- Elegant Search & Filter Section -->
        <div class="mt-10 bg-white shadow-lg rounded-xl overflow-hidden border border-gray-100">
            <div class="bg-gradient-to-r from-indigo-500/5 to-indigo-700/5 px-6 py-4 border-b border-gray-100">
                <h2 class="text-lg font-semibold text-gray-800">Find Accredited Schools</h2>
            </div>

            <div class="p-6">
                <form method="get" class="grid grid-cols-1 gap-y-4 sm:grid-cols-12 sm:gap-x-6">
                    <div class="sm:col-span-5">
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                </svg>
                            </div>
                            <input type="text" name="SearchTerm" value="@Model.SearchTerm"
                                   class="focus:ring-indigo-500 focus:border-indigo-500 block w-full pl-10 pr-4 py-2.5 sm:text-sm border-gray-300 rounded-lg shadow-sm"
                                   placeholder="Search by name or description">
                        </div>
                    </div>

                    <div class="sm:col-span-4">
                        <div class="relative">
                            <select name="TradeFilter"
                                    class="block w-full pl-3 pr-10 py-2.5 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-lg shadow-sm">
                                <option value="">All Programs</option>
                                @foreach (var trade in Model.Trades)
                                {
                                    <option value="@trade" selected="@(trade == Model.TradeFilter)">@trade</option>
                                }
                            </select>
                            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                                </svg>
                            </div>
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <button type="submit"
                                class="w-full inline-flex items-center justify-center px-4 py-2.5 border border-transparent text-sm font-medium rounded-lg shadow-sm text-white bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all duration-200">
                            <svg class="h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                            </svg>
                            Apply Filters
                        </button>
                    </div>
                </form>

                @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.TradeFilter))
                {
                    <div class="mt-5 flex items-center flex-wrap gap-2 border-t border-gray-100 pt-5">
                        <span class="text-sm text-gray-500">Active filters:</span>

                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-800 border border-blue-100 shadow-sm">
                                <span class="mr-1 text-blue-400">Search:</span> @Model.SearchTerm
                                <a href="?TradeFilter=@Model.TradeFilter" class="ml-1.5 text-blue-600 hover:text-blue-800 transition-colors">
                                    <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                                    </svg>
                                </a>
                            </span>
                        }

                        @if (!string.IsNullOrEmpty(Model.TradeFilter))
                        {
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-50 text-green-800 border border-green-100 shadow-sm">
                                <span class="mr-1 text-green-500">Program:</span> @Model.TradeFilter
                                <a href="?SearchTerm=@Model.SearchTerm" class="ml-1.5 text-green-600 hover:text-green-800 transition-colors">
                                    <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                                    </svg>
                                </a>
                            </span>
                        }

                        <a href="/AccreditedSchools" class="ml-auto text-sm text-indigo-600 hover:text-indigo-500 font-medium transition-colors">
                            Clear all filters
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Error Message with improved styling -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mt-6 rounded-xl bg-red-50 p-4 border border-red-100 shadow-sm">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm font-medium text-red-800">@TempData["ErrorMessage"]</p>
                    </div>
                </div>
            </div>
        }

        <!-- School Card Grid with enhanced cards -->
        <div class="mt-10 grid gap-8 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var school in Model.Schools)
            {
                <div class="bg-white overflow-hidden shadow-lg rounded-xl border border-gray-100 transition-all duration-300 hover:shadow-xl hover:translate-y-[-4px]">
                    <!-- School image with gradient overlay -->
                    <div class="relative h-48 bg-gray-200 overflow-hidden">
                        <img src="@(string.IsNullOrEmpty(school.ImageUrl) ? "/images/school-placeholder.jpg" : school.ImageUrl)"
                             alt="@school.InstitutionName"
                             class="w-full h-full object-cover transition-transform duration-500 hover:scale-110"
                             onerror="this.onerror=null; this.src='/images/school-placeholder.jpg';">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
                        <div class="absolute bottom-0 left-0 right-0 p-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800 border border-indigo-200 shadow-sm">
                                @school.Trade
                            </span>
                            @* <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium @GetScoreColorClass(school.AssessmentScore, true)"> *@
                                @* Score: @school.AssessmentScore *@
                            @* </span> *@
                        </div>
                    </div>

                    <div class="p-5">
                        <div class="flex flex-col h-full">
                            <div>
                                <h3 class="text-lg font-bold text-gray-900 line-clamp-1">@school.InstitutionName</h3>

                                <div class="mt-1 flex items-center space-x-1 text-sm text-gray-500">
                                    <svg class="h-4 w-4 text-gray-400 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                                    </svg>
                                    @* <span>Approved: @school.ApprovalDateFormatted</span> *@
                                </div>

                                <p class="mt-3 text-sm text-gray-600 line-clamp-3">@school.ShortDescription</p>
                            </div>

                            <div class="mt-6 pt-4 border-t border-dashed border-gray-200">
                                <button type="button"
                                        onclick="openModal('@school.Id')"
                                        class="w-full inline-flex items-center justify-center px-4 py-2.5 border border-indigo-600 text-sm font-medium rounded-lg text-indigo-700 bg-white hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-200">
                                    <svg class="h-4 w-4 mr-1.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    View Details
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Enhanced Pagination with improved styling -->
        @if (Model.TotalPages > 1)
        {
            <div class="mt-12 flex justify-center">
                <nav class="relative z-0 inline-flex rounded-md shadow-md -space-x-px overflow-hidden" aria-label="Pagination">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="?CurrentPage=@(Model.CurrentPage - 1)&SearchTerm=@Model.SearchTerm&TradeFilter=@Model.TradeFilter"
                           class="relative inline-flex items-center px-3 py-2.5 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">
                            <span class="sr-only">Previous</span>
                            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <a href="?CurrentPage=@i&SearchTerm=@Model.SearchTerm&TradeFilter=@Model.TradeFilter"
                           class="relative inline-flex items-center px-4 py-2.5 border border-gray-300 text-sm font-medium
                              @(i == Model.CurrentPage
                                ? "bg-indigo-50 text-indigo-700 border-indigo-500 z-10 font-bold"
                                : "bg-white text-gray-700 hover:bg-gray-50") transition-colors">
                            @i
                        </a>
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="?CurrentPage=@(Model.CurrentPage + 1)&SearchTerm=@Model.SearchTerm&TradeFilter=@Model.TradeFilter"
                           class="relative inline-flex items-center px-3 py-2.5 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">
                            <span class="sr-only">Next</span>
                            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    }
                </nav>
            </div>
        }
    </div>

 
</div>

<!-- Modals -->
@foreach (var school in Model.Schools)
{
    <div id="modal-@school.Id" class="fixed inset-0 hidden overflow-y-auto overflow-x-hidden z-50">
        <div class="flex items-center justify-center min-h-screen p-4">
            <!-- Modal backdrop with click-away -->
            <div class="fixed inset-0 transition-opacity" aria-hidden="true" onclick="closeModal('@school.Id')">
                <div class="absolute inset-0 bg-gray-500 opacity-75"></div>
            </div>

            <!-- Modal content -->
            <div class="relative bg-white rounded-lg max-w-3xl w-full mx-auto shadow-xl overflow-hidden"
                 aria-labelledby="modal-title-@school.Id" role="dialog" aria-modal="true"
                 onclick="event.stopPropagation()">
                <div class="absolute top-0 right-0 pt-4 pr-4">
                    <button type="button" onclick="closeModal('@school.Id')" class="text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" aria-label="Close">
                        <span class="sr-only">Close</span>
                        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <div class="px-4 pt-5 pb-4 sm:p-6">
                    <h3 class="text-lg font-medium text-gray-900" id="modal-title-@school.Id">
                        @school.InstitutionName
                    </h3>

                    <div class="mt-4 sm:flex">
                        <div class="sm:w-1/3 sm:pr-4">
                            <div class="aspect-w-4 aspect-h-3 rounded-lg overflow-hidden bg-gray-100">
                                <img src="@school.ImageUrl" alt="@school.InstitutionName" class="w-full h-full object-cover"
                                     onerror="this.onerror=null; this.src='../images/GlobalEducationCharter.jpg';">
                            </div>

                            <div class="mt-4 bg-gray-50 rounded-lg p-4">
                                <h4 class="text-sm font-medium text-gray-900 mb-2">Accreditation Details</h4>
                                <div class="space-y-2">
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-500">Status:</span>
                                        <span class="text-sm font-medium text-green-600">Approved</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-500">Program:</span>
                                        <span class="text-sm text-gray-900">@school.Trade</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-500">Since:</span>
                                        @* <span class="text-sm text-gray-900">@school.ApprovalDateFormatted</span> *@
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 sm:mt-0 sm:w-2/3">
                            <div>
                                <h4 class="text-sm font-medium text-gray-900">About</h4>
                                <p class="mt-2 text-sm text-gray-500">
                                    @(string.IsNullOrEmpty(school.Comments) ?
                                        "This is an accredited educational institution meeting our rigorous standards for quality education." :
                                        school.Comments)
                                </p>
                            </div>

                            <div class="mt-6">
                                <h4 class="text-sm font-medium text-gray-900">Contact Information</h4>
                                <dl class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-3">
                                    <div class="sm:col-span-1">
                                        <dt class="text-sm text-gray-500">Email</dt>
                                        <dd class="mt-1 text-sm text-gray-900">
                                            <a href="mailto:@school.Email" class="text-indigo-600 hover:text-indigo-500">
                                                @school.Email
                                            </a>
                                        </dd>
                                    </div>
                                    <div class="sm:col-span-1">
                                        <dt class="text-sm text-gray-500">Contact Person</dt>
                                        <dd class="mt-1 text-sm text-gray-900">@(string.IsNullOrEmpty(school.ContactPerson) ? "N/A" : school.ContactPerson)</dd>
                                    </div>
                                </dl>
                            </div>

                            <div class="mt-6">
                                <h4 class="text-sm font-medium text-gray-900">Assessment Score</h4>
                                <div class="mt-2 bg-gray-50 rounded-lg p-4">
                                    <div class="flex items-center">
                                        <div class="w-full bg-gray-200 rounded-full h-2.5">
                                            <div class="@GetScoreColorClass(school.AssessmentScore) h-2.5 rounded-full"
                                                 style="width: @(school.AssessmentScore * 5)%"></div>
                                        </div>
                                        <span class="ml-2 text-sm text-gray-700">@school.AssessmentScore/20</span>
                                    </div>
                                    <p class="text-xs text-gray-500 mt-1">
                                        @* @GetScoreDescription(school.AssessmentScore) *@
                                    </p> 
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="px-4 py-3 bg-gray-50 sm:px-6 sm:flex sm:flex-row-reverse">
                    <a href="/SchoolDetails/@school.Id" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        View Full Profile
                    </a>
                    <button type="button" onclick="closeModal('@school.Id')" class="mt-3 sm:mt-0 sm:mr-3 inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@functions {
    private string GetScoreColorClass(int score)
    {
        return score switch
        {
            >= 15 => "bg-green-600",
            >= 10 => "bg-yellow-500",
            _ => "bg-red-500"
        };
    }

    private string GetScoreDescription(int score)
    {
        return score switch
        {
            >= 15 => "Excellent - Exceeds quality standards",
            >= 10 => "Good - Meets all quality standards",
            _ => "Conditional - Meets minimum standards"
        };
    }
}

@section Scripts {
    <script>
        function openModal(id) {
            document.getElementById('modal-' + id).classList.remove('hidden');
            document.body.classList.add('overflow-hidden');

            // Set focus for accessibility
            setTimeout(() => {
                const closeButton = document.querySelector(`#modal-${id} button[aria-label="Close"]`);
                if (closeButton) closeButton.focus();
            }, 100);

            // Escape key handler
            const escHandler = (e) => { if (e.key === 'Escape') closeModal(id); };
            document.addEventListener('keydown', escHandler);

            // Store the handler to remove it later
            window._modalEscHandlers = window._modalEscHandlers || {};
            window._modalEscHandlers[id] = escHandler;
        }

        function closeModal(id) {
            document.getElementById('modal-' + id).classList.add('hidden');
            document.body.classList.remove('overflow-hidden');

            // Remove event listener
            if (window._modalEscHandlers && window._modalEscHandlers[id]) {
                document.removeEventListener('keydown', window._modalEscHandlers[id]);
                delete window._modalEscHandlers[id];
            }
        }

    </script>
}
 