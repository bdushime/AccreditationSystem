@page
@model AccreditationSystem.Pages.Admin.SubmitClaimModel
@{
    ViewData["Title"] = "Submit Accreditation Claim";

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(TempData["SuccessMessage"] as string))
    {
                <div class="max-w-5xl mx-auto mb-6 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" role="alert">
                    <span class="block sm:inline">@TempData["SuccessMessage"]</span>
                </div>
    }

    @if (!string.IsNullOrEmpty(TempData["ErrorMessage"] as string))
    {
                <div class="max-w-5xl mx-auto mb-6 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
                    <span class="block sm:inline">@TempData["ErrorMessage"]</span>
                </div>
    }
}

@section Styles {
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap">
        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        fontFamily: {
                            jakarta: ['"Plus Jakarta Sans"', 'sans-serif'],
                        },
                        colors: {
                            primary: {
                                50: '#f0f9ff',
                                100: '#e0f2fe',
                                200: '#bae6fd',
                                300: '#7dd3fc',
                                400: '#38bdf8',
                                500: '#0ea5e9',
                                600: '#0284c7',
                                700: '#0369a1',
                                800: '#075985',
                                900: '#0c4a6e',
                            },
                        }
                    }
                }
            }
        </script>
        <style>
            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
            }
        </style>
}
<!-- Header Section with Logo -->
<header class="bg-white shadow-md">
    <div class="container mx-auto px-4 py-3">
        <div class="flex justify-between items-center">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <!-- Logo -->
                    <a href="/" class="flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-primary-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 10v6M2 10l10-7 10 7-10 7-10-7v10a8 8 0 1016 0" />
                        </svg>
                        <span class="ml-3 text-xl font-bold text-gray-900">Accreditation</span>
                    </a>
                </div>
                <!-- Navigation -->
                <nav class="hidden md:ml-8 md:flex space-x-6">
                    <a href="/" class="text-primary-700 font-medium">Home</a>
                    @* <a href="/about" class="text-gray-600 hover:text-primary-700 font-medium">About</a> *@
                    @* <a href="/services" class="text-gray-600 hover:text-primary-700 font-medium">Services</a> *@
                    @* <a href="/resources" class="text-gray-600 hover:text-primary-700 font-medium">Resources</a> *@
                    @* <a href="/contact" class="text-gray-600 hover:text-primary-700 font-medium">Contact</a> *@
                </nav>
            </div>
            <!-- Auth Buttons -->
            <div class="flex items-center space-x-3">
                <a href="/Auth/Login" class="px-4 py-2 text-primary-700 font-medium rounded-md border border-primary-600 hover:bg-primary-50 transition duration-300">Login</a>
                <a href="/Auth/Register" class="px-4 py-2 bg-primary-600 text-white font-medium rounded-md hover:bg-primary-700 transition duration-300">Register</a>
            </div>
        </div>
    </div>
</header>

<div class="container mx-auto px-4 py-8">
    <!-- Page Title -->
    <div class="mb-8 text-center">
        <h1 class="text-3xl font-bold text-gray-800 mb-2">Submit Accreditation Claim</h1>
        <p class="text-gray-600">Complete the form below to submit your accreditation claim for review</p>
    </div>

    <form method="post" class="max-w-5xl mx-auto bg-white shadow-lg rounded-lg overflow-hidden" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <!-- Form Header -->
        <div class="bg-primary-700 px-6 py-4">
            <h2 class="text-xl font-semibold text-white">Claim Information</h2>
        </div>

        <!-- Form Content -->
        <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Left Column -->
                <div>
                    <h3 class="text-lg font-medium text-gray-800 mb-4">Claim Details</h3>

                    <!-- School Email -->
                    <div class="mb-4">
                        <label for="schoolEmail" class="block text-sm font-medium text-gray-700 mb-1">School Email <span class="text-red-500">*</span></label>
                        <input type="email" id="email" name="email" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" placeholder="Enter your school email address" required>
                    </div>

                    <!-- Accreditation Type -->
                    <div class="mb-4">
                        <label for="accreditationType" class="block text-sm font-medium text-gray-700 mb-1">Accreditation Type <span class="text-red-500">*</span></label>
                        <select id="accreditationType" name="accreditationType" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" required>
                            <option value="" disabled selected>Select accreditation type</option>
                            <option value="regional">Regional Accreditation</option>
                            <option value="national">National Accreditation</option>
                            <option value="programmatic">Programmatic Accreditation</option>
                            <option value="international">International Accreditation</option>
                            <option value="specialized">Specialized Accreditation</option>
                        </select>
                    </div>

                    <!-- Accreditation Level -->
                    <div class="mb-4">
                        <label for="accreditationLevel" class="block text-sm font-medium text-gray-700 mb-1">Accreditation Level <span class="text-red-500">*</span></label>
                        <select id="accreditationLevel" name="accreditationLevel" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" required>
                            <option value="" disabled selected>Select accreditation level</option>
                            <option value="initial">Initial Accreditation</option>
                            <option value="provisional">Provisional Accreditation</option>
                            <option value="full">Full Accreditation</option>
                            <option value="distinguished">Distinguished Accreditation</option>
                            <option value="renewal">Accreditation Renewal</option>
                        </select>
                    </div>

                    <!-- Previous Accreditation Status -->
                    <div class="mb-4">
                        <label for="previousStatus" class="block text-sm font-medium text-gray-700 mb-1">Previous Accreditation Status</label>
                        <select id="previousStatus" name="previousStatus" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500">
                            <option value="" disabled selected>Select previous status (if applicable)</option>
                            <option value="none">None (First Time Application)</option>
                            <option value="denied">Previously Denied</option>
                            <option value="probation">On Probation</option>
                            <option value="expired">Expired</option>
                            <option value="active">Currently Active</option>
                        </select>
                    </div>

                    <!-- Accreditation Period -->
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Requested Accreditation Period <span class="text-red-500">*</span></label>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="startDate" class="block text-sm font-medium text-gray-700 mb-1">Start Date</label>
                                <input type="date" id="startDate" name="startDate" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" required>
                            </div>
                            <div>
                                <label for="endDate" class="block text-sm font-medium text-gray-700 mb-1">End Date</label>
                                <input type="date" id="endDate" name="endDate" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" required>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column -->
                <div>
                    <h3 class="text-lg font-medium text-gray-800 mb-4">Supporting Documentation</h3>

                    <!-- Self-Assessment Report -->
                    <div class="mb-4">
                        <label for="selfAssessmentReport" class="block text-sm font-medium text-gray-700 mb-1">Self-Assessment Report <span class="text-red-500">*</span></label>
                        <input type="file" id="selfAssessmentReport" name="selfAssessmentReport" accept=".pdf,.doc,.docx" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" required>
                        <p class="mt-1 text-sm text-gray-500">Upload a completed self-assessment report (PDF, DOC, DOCX)</p>
                    </div>

                    <!-- Curriculum Documentation -->
                    <div class="mb-4">
                        <label for="curriculumDocumentation" class="block text-sm font-medium text-gray-700 mb-1">Curriculum Documentation <span class="text-red-500">*</span></label>
                        <input type="file" id="curriculumDocumentation" name="curriculumDocumentation" accept=".pdf,.doc,.docx,.zip" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" required>
                        <p class="mt-1 text-sm text-gray-500">Upload curriculum documents (PDF, DOC, DOCX, ZIP)</p>
                    </div>

                    <!-- Faculty Credentials -->
                    <div class="mb-4">
                        <label for="facultyCredentials" class="block text-sm font-medium text-gray-700 mb-1">Faculty Credentials <span class="text-red-500">*</span></label>
                        <input type="file" id="facultyCredentials" name="facultyCredentials" accept=".pdf,.doc,.docx,.zip,.xlsx" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" required>
                        <p class="mt-1 text-sm text-gray-500">Upload faculty qualification documents (PDF, DOC, DOCX, ZIP, XLSX)</p>
                    </div>


                    <!-- Additional Documentation -->
                    <div class="mb-4">
                        <label for="additionalDocumentation" class="block text-sm font-medium text-gray-700 mb-1">Additional Supporting Documents</label>
                        <input type="file" id="additionalDocumentation" name="additionalDocumentation" accept=".pdf,.doc,.docx,.zip,.xlsx,.xls" multiple class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500">
                        <p class="mt-1 text-sm text-gray-500">Upload any additional supporting documents (Optional)</p>
                    </div>
                </div>
            </div>

            <!-- Standards Compliance Section - Full Width -->
            <div class="mt-8">
                <h3 class="text-lg font-medium text-gray-800 mb-4">Standards Compliance</h3>
                <div class="bg-gray-50 p-4 rounded-lg mb-6">
                    <p class="text-sm text-gray-700 mb-4">Please indicate how your institution meets the following accreditation standards:</p>

                    <!-- Academic Excellence -->
                    <div class="mb-4">
                        <label for="academicStandards" class="block text-sm font-medium text-gray-700 mb-1">Academic Excellence Standards <span class="text-red-500">*</span></label>
                        <textarea id="academicStandards" name="academicStandards" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" placeholder="Describe how your institution meets academic excellence standards..." required></textarea>
                    </div>

                    <!-- Faculty Qualifications -->
                    <div class="mb-4">
                        <label for="facultyStandards" class="block text-sm font-medium text-gray-700 mb-1">Faculty Qualifications Standards <span class="text-red-500">*</span></label>
                        <textarea id="facultyStandards" name="facultyStandards" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" placeholder="Describe how your faculty meets qualification standards..." required></textarea>
                    </div>

                    <!-- Facility Standards -->
                    <div class="mb-4">
                        <label for="facilityStandards" class="block text-sm font-medium text-gray-700 mb-1">Facility Standards <span class="text-red-500">*</span></label>
                        <textarea id="facilityStandards" name="facilityStandards" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" placeholder="Describe how your facilities meet required standards..." required></textarea>
                    </div>

                    <!-- Student Services -->
                    <div class="mb-4">
                        <label for="studentServices" class="block text-sm font-medium text-gray-700 mb-1">Student Services Standards <span class="text-red-500">*</span></label>
                        <textarea id="studentServices" name="studentServices" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" placeholder="Describe how your student services meet required standards..." required></textarea>
                    </div>
                </div>
            </div>

            <!-- Contact Information Section -->
            <div class="mt-6">
                <h3 class="text-lg font-medium text-gray-800 mb-4">Primary Contact Information</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="contactName" class="block text-sm font-medium text-gray-700 mb-1">Contact Name <span class="text-red-500">*</span></label>
                        <input type="text" id="contactName" name="contactName" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" placeholder="Full name" required>
                    </div>
                    <div>
                        <label for="contactPosition" class="block text-sm font-medium text-gray-700 mb-1">Position/Title <span class="text-red-500">*</span></label>
                        <input type="text" id="contactPosition" name="contactPosition" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" placeholder="Position/Title" required>
                    </div>
                    <div>
                        <label for="contactEmail" class="block text-sm font-medium text-gray-700 mb-1">Email <span class="text-red-500">*</span></label>
                        <input type="email" id="contactEmail" name="contactEmail" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" placeholder="Email address" required>
                    </div>
                    <div>
                        <label for="contactPhone" class="block text-sm font-medium text-gray-700 mb-1">Phone <span class="text-red-500">*</span></label>
                        <input type="tel" id="contactPhone" name="contactPhone" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" placeholder="Phone number" required>
                    </div>
                </div>
            </div>

            <!-- Additional Comments -->
            <div class="mt-6">
                <label for="additionalComments" class="block text-sm font-medium text-gray-700 mb-1">Additional Comments or Special Considerations</label>
                <textarea id="additionalComments" name="additionalComments" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" placeholder="Enter any additional information or special considerations for your claim..."></textarea>
            </div>

            <!-- Divider -->
            <div class="border-t border-gray-200 my-8"></div>

            <!-- Certification and Agreement -->
            <div class="mb-6">
                <h3 class="text-lg font-medium text-gray-800 mb-4">Certification and Agreement</h3>
                <div class="bg-gray-50 p-4 rounded-lg mb-4">
                    <p class="text-sm text-gray-700">By submitting this claim, I certify that:</p>
                    <ul class="list-disc pl-5 mt-2 text-sm text-gray-700 space-y-1">
                        <li>All information provided is true, complete, and accurate to the best of my knowledge.</li>
                        <li>I am authorized to submit this accreditation claim on behalf of the institution.</li>
                        <li>The institution agrees to comply with all accreditation requirements and standards.</li>
                        <li>The institution will participate fully in the accreditation review process.</li>
                        <li>I understand that providing false information may result in denial or revocation of accreditation.</li>
                    </ul>
                </div>


            </div>



            <!-- Form Actions -->
            <div class="flex justify-between">
                <a href="/Dashboard" class="px-6 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                    Cancel
                </a>
                <div class="flex space-x-3">
                    <button type="submit" class="px-6 py-2 bg-primary-600 text-white font-medium rounded-md hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                        Submit Claim
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- JavaScript for Form Validation and Handling -->
<script>
    // Function to save form as draft
    function saveAsDraft() {
        // Add hidden field to indicate draft status
        const draftInput = document.createElement('input');
        draftInput.type = 'hidden';
        draftInput.name = 'isDraft';
        draftInput.value = 'true';
        document.querySelector('form').appendChild(draftInput);

        // Submit the form
        document.querySelector('form').submit();
    }

    // Form validation
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('form');

        form.addEventListener('submit', function(event) {
            // Basic validation
            const requiredFields = form.querySelectorAll('[required]');
            let isValid = true;

            requiredFields.forEach(field => {
                if (!field.value.trim()) {
                    isValid = false;
                    field.classList.add('border-red-500');
                } else {
                    field.classList.remove('border-red-500');
                }
            });

            // Date validation
            const startDate = new Date(document.getElementById('startDate').value);
            const endDate = new Date(document.getElementById('endDate').value);

            if (endDate <= startDate) {
                isValid = false;
                document.getElementById('endDate').classList.add('border-red-500');
                alert('End date must be after start date');
            }

            if (!isValid) {
                event.preventDefault();
                window.scrollTo(0, 0);
            }
        });
    });
</script>