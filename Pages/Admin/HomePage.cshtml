@page
@model AccreditationSchoolSystem.Pages.HomePageModel
@{
    ViewData["Title"] = "Accreditation School System";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <style>
        :root {
            --midnight-blue: #191970;
            --midnight-blue-light: #2a2a8a;
            --midnight-blue-dark: #0c0c45;
            --accent-gold: #ffd700;
            --accent-gold-light: #ffe666;
            --light-bg: #f8f9fa;
            --light-gray: #e9ecef;
            --medium-gray: #ced4da;
            --dark-gray: #6c757d;
            --white: #ffffff;
            --shadow-sm: 0 .125rem .25rem rgba(0,0,0,.075);
            --shadow: 0 .5rem 1rem rgba(0,0,0,.15);
            --shadow-lg: 0 1rem 3rem rgba(0,0,0,.175);
            --border-radius: 0.5rem;
            --border-radius-lg: 1rem;
            --transition: all 0.3s ease;
        }

        /* Global Styles */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            background-color: var(--light-bg);
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 15px;
        }

        a {
            text-decoration: none;
            color: inherit;
            transition: var(--transition);
        }

        button, .btn {
            cursor: pointer;
            transition: var(--transition);
        }

        /* Header Styles */
        header {
            background-color: var(--white);
            box-shadow: var(--shadow-sm);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .header-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 0;
        }

        .logo {
            display: flex;
            align-items: center;
            font-weight: 700;
            color: var(--midnight-blue);
            font-size: 1.5rem;
        }

        .logo-text {
            position: relative;
        }

            .logo-text::after {
                content: '';
                position: absolute;
                bottom: -4px;
                left: 0;
                width: 40px;
                height: 3px;
                background-color: var(--accent-gold);
                border-radius: 2px;
            }

        .nav-links {
            display: flex;
            list-style-type: none;
            margin: 0;
            padding: 0;
            gap: 1.5rem;
        }

            .nav-links a {
                color: var(--dark-gray);
                font-weight: 500;
                padding: 0.5rem 0;
                position: relative;
            }

                .nav-links a:hover {
                    color: var(--midnight-blue);
                }

                .nav-links a::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    width: 0;
                    height: 2px;
                    background-color: var(--midnight-blue);
                    transition: width 0.3s ease;
                }

                .nav-links a:hover::after {
                    width: 100%;
                }

        .auth-buttons {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .search-icon, .language-selector {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--light-gray);
            color: var(--dark-gray);
            cursor: pointer;
            transition: var(--transition);
        }

            .search-icon:hover, .language-selector:hover {
                background-color: var(--medium-gray);
                color: var(--midnight-blue);
            }

        .login-btn {
            color: var(--midnight-blue);
            font-weight: 600;
            padding: 0.5rem 1rem;
            border-radius: var(--border-radius);
            border: 1px solid var(--midnight-blue);
            transition: var(--transition);
        }

            .login-btn:hover {
                background-color: rgba(25, 25, 112, 0.1);
            }

        .signup-btn {
            background-color: var(--midnight-blue);
            color: var(--white);
            font-weight: 600;
            padding: 0.5rem 1rem;
            border-radius: var(--border-radius);
            transition: var(--transition);
        }

            .signup-btn:hover {
                background-color: var(--midnight-blue-light);
            }

        .menu-toggle {
            display: none;
            font-size: 1.5rem;
            color: var(--midnight-blue);
            cursor: pointer;
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(135deg, var(--midnight-blue) 0%, var(--midnight-blue-light) 100%);
            position: relative;
            padding: 5rem 0;
            color: var(--white);
            overflow: hidden;
        }

            .hero::before {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 100%;
                height: 100%;
                background-image: url("/images/hero-bg.JPG");
                opacity: 1.0;
            }

        .hero-content {
            position: relative;
            z-index: 1;
            text-align: center;
            max-width: 800px;
            margin: 0 auto;
        }

        .hero h1 {
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 1rem;
            text-transform: capitalize;
            position: relative;
            display: inline-block;
        }

            .hero h1::after {
                content: '';
                position: absolute;
                bottom: -10px;
                left: 50%;
                transform: translateX(-50%);
                width: 100px;
                height: 4px;
                background-color: var(--accent-gold);
                border-radius: 2px;
            }

        .hero p {
            font-size: 1.25rem;
            margin-bottom: 2rem;
            color: rgba(255, 255, 255, 0.9);
        }

        .countdown {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 2rem;
        }

        .countdown-item {
            text-align: center;
        }

            .countdown-item:nth-child(2n) {
                font-size: 2rem;
                font-weight: 700;
                margin: 0 -5px;
            }

        .countdown-value {
            background-color: rgba(255, 255, 255, 0.15);
            border-radius: var(--border-radius);
            padding: 1rem 1.5rem;
            font-size: 2rem;
            font-weight: 700;
            color: var(--white);
        }

        .countdown-label {
            margin-top: 0.5rem;
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.8);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .hero-btn {
            display: inline-block;
            background-color: var(--accent-gold);
            color: var(--midnight-blue);
            font-weight: 700;
            padding: 1rem 2rem;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            transition: var(--transition);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

            .hero-btn:hover {
                background-color: var(--accent-gold-light);
                transform: translateY(-3px);
                box-shadow: var(--shadow-lg);
            }

        /* Search Section */
        .search-section {
            background-color: var(--white);
            border-radius: var(--border-radius-lg);
            box-shadow: var(--shadow);
            padding: 2rem;
            margin-top: -50px;
            position: relative;
            z-index: 10;
            margin-bottom: 3rem;
        }

        .search-tabs {
            display: flex;
            gap: 1rem;
            margin-bottom: 1.5rem;
            overflow-x: auto;
            padding-bottom: 0.5rem;
        }

        .search-tab {
            padding: 0.75rem 1.25rem;
            background-color: var(--light-bg);
            color: var(--dark-gray);
            border-radius: var(--border-radius);
            cursor: pointer;
            font-weight: 600;
            transition: var(--transition);
            white-space: nowrap;
        }

            .search-tab.active, .search-tab:hover {
                background-color: var(--midnight-blue);
                color: var(--white);
            }

        .round-trip-options {
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .trip-option {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
        }

            .trip-option input[type="radio"], .trip-option input[type="checkbox"] {
                cursor: pointer;
                width: 18px;
                height: 18px;
            }

            .trip-option label {
                cursor: pointer;
                margin-bottom: 0;
                font-weight: 500;
            }

        .search-form {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: flex-end;
        }

        .form-group {
            flex: 1;
            min-width: 200px;
        }

            .form-group label {
                display: block;
                margin-bottom: 0.5rem;
                font-weight: 500;
                color: var(--dark-gray);
            }

            .form-group input, .form-group select {
                width: 100%;
                padding: 0.75rem 1rem;
                border: 1px solid var(--medium-gray);
                border-radius: var(--border-radius);
                font-size: 1rem;
                transition: var(--transition);
            }

                .form-group input:focus, .form-group select:focus {
                    border-color: var(--midnight-blue);
                    box-shadow: 0 0 0 0.25rem rgba(25, 25, 112, 0.25);
                    outline: none;
                }

        .date-group {
            position: relative;
        }

        .date-value {
            padding: 0.75rem 1rem;
            border: 1px solid var(--medium-gray);
            border-radius: var(--border-radius);
            cursor: pointer;
            background-color: var(--white);
            transition: var(--transition);
        }

            .date-value:hover {
                border-color: var(--midnight-blue-light);
            }

        .destination-arrows {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background-color: var(--light-gray);
            border-radius: 50%;
            color: var(--dark-gray);
            margin: 0 0.5rem;
            cursor: pointer;
            transition: var(--transition);
        }

            .destination-arrows:hover {
                background-color: var(--midnight-blue);
                color: var(--white);
            }

        .promo-code-link {
            color: var(--midnight-blue);
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .promo-code-link:hover {
                color: var(--midnight-blue-light);
                text-decoration: underline;
            }

        .search-btn {
            background-color: var(--midnight-blue);
            color: var(--white);
            border: none;
            padding: 1rem 2rem;
            border-radius: var(--border-radius);
            font-weight: 600;
            font-size: 1rem;
            margin-top: 1rem;
            transition: var(--transition);
            align-self: center;
        }

            .search-btn:hover {
                background-color: var(--midnight-blue-light);
                transform: translateY(-2px);
                box-shadow: var(--shadow);
            }

        /* Quick Links */
        .quick-links {
            margin-bottom: 4rem;
        }

        .quick-links-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 2fr));
            gap: 4.0rem;
        }

        .quick-link {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 2.0rem 2rem;
            background-color: var(--white);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
        }

            .quick-link:hover {
                transform: translateY(-5px);
                box-shadow: var(--shadow);
                background-color: var(--midnight-blue);
                color: var(--white);
            }

            .quick-link i {
                font-size: 2rem;
                margin-bottom: 1rem;
                color: var(--midnight-blue);
                transition: var(--transition);
            }

            .quick-link:hover i {
                color: var(--accent-gold);
            }

        .quick-link-title {
            font-weight: 600;
        }

        /* Section Styles */
        .section-title {
            text-align: center;
            margin-bottom: 2rem;
            color: var(--midnight-blue);
            font-weight: 700;
            position: relative;
            padding-bottom: 1rem;
        }

            .section-title::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 50%;
                transform: translateX(-50%);
                width: 80px;
                height: 3px;
                background-color: var(--accent-gold);
                border-radius: 2px;
            }

        /* Services Grid */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 2rem;
            margin-bottom: 4rem;
        }

        .service-card {
            background-color: var(--white);
            border-radius: var(--border-radius);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
        }

            .service-card:hover {
                transform: translateY(-5px);
                box-shadow: var(--shadow);
            }

        .service-img {
            height: 200px;
            background-size: cover;
            background-position: center;
            position: relative;
        }

        .service-img-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
            display: flex;
            align-items: flex-end;
            padding: 1.5rem;
        }

        .service-img-title {
            color: var(--white);
            font-weight: 700;
            font-size: 1.25rem;
        }

        .service-content {
            padding: 1.5rem;
        }

        .service-description {
            color: var(--dark-gray);
            margin-bottom: 1.5rem;
        }

        .service-btn {
            display: inline-block;
            color: var(--midnight-blue);
            font-weight: 600;
            padding: 0.5rem 1rem;
            border: 1px solid var(--midnight-blue);
            border-radius: var(--border-radius);
            transition: var(--transition);
        }

            .service-btn:hover {
                background-color: var(--midnight-blue);
                color: var(--white);
            }

        /* Featured Destinations */
        .featured-destinations {
            margin-bottom: 4rem;
        }

        .destination-card {
            position: relative;
            overflow: hidden;
        }

        .destination-img {
            width: 100%;
            height: 250px;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .destination-card:hover .destination-img {
            transform: scale(1.1);
        }

        .destination-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            padding: 1.5rem;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
            color: var(--white);
            transition: var(--transition);
        }

        .destination-card:hover .destination-overlay {
            padding-bottom: 2rem;
        }

        .destination-name {
            font-weight: 700;
            font-size: 1.25rem;
            margin-bottom: 0.5rem;
        }

        .destination-dates {
            font-size: 0.875rem;
            opacity: 0.9;
            margin-bottom: 0.5rem;
        }

        .destination-price {
            font-weight: 700;
            color: var(--accent-gold);
        }

        /* Newsletter Section */
        .newsletter {
            background-color: var(--midnight-blue);
            padding: 4rem 0;
            margin-bottom: 4rem;
            position: relative;
            overflow: hidden;
        }

            .newsletter::before {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 100%;
                height: 100%;
                background-image: url("/images/hero-bg.JPG");
                opacity: 1.0;
            }

        .newsletter-content {
            position: relative;
            z-index: 1;
            color: var(--white);
            background-color: rgba(25, 25, 112, 0.5);
            border-radius: var(--border-radius-lg);
            padding: 2rem;
            box-shadow: var(--shadow);
            backdrop-filter: blur(10px);
        }

        .newsletter-text {
            text-align: center;
            margin-bottom: 2rem;
        }

            .newsletter-text h3 {
                font-weight: 700;
                font-size: 1.75rem;
                margin-bottom: 1rem;
            }

            .newsletter-text p {
                color: rgba(255, 255, 255, 0.9);
                max-width: 600px;
                margin: 0 auto;
            }

        .newsletter-form {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

            .newsletter-form input[type="email"],
            .newsletter-form input[type="text"] {
                padding: 0.75rem 1rem;
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: var(--border-radius);
                background-color: rgba(255, 255, 255, 0.1);
                color: var(--white);
                width: 100%;
            }

            .newsletter-form input::placeholder {
                color: rgba(255, 255, 255, 0.6);
            }

            .newsletter-form input:focus {
                outline: none;
                border-color: var(--accent-gold);
                background-color: rgba(255, 255, 255, 0.2);
            }

        .checkbox-group {
            grid-column: span 2;
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            margin: 1rem 0;
        }

            .checkbox-group input[type="checkbox"] {
                margin-top: 0.25rem;
            }

            .checkbox-group label {
                font-size: 0.875rem;
                color: rgba(255, 255, 255, 0.9);
            }

        .newsletter-form button {
            grid-column: span 2;
            background-color: var(--accent-gold);
            color: var(--midnight-blue-dark);
            border: none;
            padding: 0.75rem 2rem;
            border-radius: var(--border-radius);
            font-weight: 600;
            transition: var(--transition);
            margin: 0 auto;
        }

            .newsletter-form button:hover {
                background-color: var(--accent-gold-light);
                transform: translateY(-2px);
            }

        /* Achievements Section */
        .achievements {
            background-color: var(--white);
            padding: 4rem 0;
            margin-bottom: 4rem;
            text-align: center;
        }

            .achievements h2 {
                color: var(--midnight-blue);
                font-weight: 700;
                margin-bottom: 3rem;
                position: relative;
                display: inline-block;
                padding-bottom: 1rem;
            }

                .achievements h2::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 60px;
                    height: 3px;
                    background-color: var(--accent-gold);
                    border-radius: 2px;
                }

        .timeline {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 2rem;
            max-width: 900px;
            margin: 0 auto;
        }

        .timeline-item {
            background-color: var(--light-bg);
            padding: 1.5rem;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-sm);
            width: 100%;
            max-width: 280px;
            position: relative;
            transition: var(--transition);
        }

            .timeline-item:hover {
                transform: translateY(-5px);
                box-shadow: var(--shadow);
                background-color: var(--white);
            }

            .timeline-item::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 4px;
                height: 40px;
                background-color: var(--accent-gold);
                border-radius: 2px;
            }

        .timeline-date {
            color: var(--midnight-blue);
            font-weight: 700;
            margin-bottom: 0.5rem;
            font-size: 1.125rem;
        }

        .timeline-title {
            color: var(--dark-gray);
            font-size: 0.9rem;
            line-height: 1.5;
        }

        /* Footer */
        footer {
            background-color: var(--midnight-blue-dark);
            color: var(--white);
            padding: 4rem 0 2rem;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .footer-column h4 {
            font-weight: 700;
            margin-bottom: 1.5rem;
            position: relative;
            display: inline-block;
            padding-bottom: 0.75rem;
        }

            .footer-column h4::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 40px;
                height: 3px;
                background-color: var(--accent-gold);
                border-radius: 2px;
            }

        .footer-links {
            list-style-type: none;
            padding: 0;
            margin: 0;
        }

            .footer-links li {
                margin-bottom: 0.75rem;
            }

            .footer-links a {
                color: rgba(255, 255, 255, 0.7);
                transition: var(--transition);
            }

                .footer-links a:hover {
                    color: var(--white);
                    padding-left: 5px;
                }

        .social-links {
            display: flex;
            gap: 0.75rem;
            margin-top: 1.5rem;
        }

        .social-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            color: var(--white);
            transition: var(--transition);
        }

            .social-icon:hover {
                background-color: var(--accent-gold);
                color: var(--midnight-blue);
                transform: translateY(-3px);
            }

        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 2rem;
            text-align: center;
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.7);
        }

        .footer-bottom-links {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 1.5rem;
            margin-bottom: 1rem;
        }

            .footer-bottom-links a {
                color: rgba(255, 255, 255, 0.7);
                transition: var(--transition);
            }

                .footer-bottom-links a:hover {
                    color: var(--white);
                }

        /* Success Message */
        .success-message {
            position: fixed;
            top: 20px;
            right: 20px;
            background-color: var(--status-active);
            color: var(--white);
            padding: 1rem 1.5rem;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            z-index: 1100;
            animation: slideInRight 0.3s ease-out forwards;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes pulse {
            0% {
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(25, 25, 112, 0.7);
            }

            70% {
                transform: scale(1.05);
                box-shadow: 0 0 0 10px rgba(25, 25, 112, 0);
            }

            100% {
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(25, 25, 112, 0);
            }
        }

        @@keyframes shimmer {
            0% {
                transform: translate(-100%, -100%) rotate(30deg);
            }

            100% {
                transform: translate(100%, 100%) rotate(30deg);
            }
        }


        /* Responsive Adjustments */
        @@media (max-width: 991.98px) {
            .tvet-hero {
                padding: 4rem 0;
            }

                .tvet-hero .display-4 {
                    font-size: 2.5rem;
                }

            .cta-card {
                padding: 2rem;
            }
        }

        @@media (max-width: 767.98px) {
            .tvet-hero {
                padding: 3rem 0;
            }

                .tvet-hero .display-4 {
                    font-size: 2rem;
                }

            .tvet-stats {
                margin-top: -20px;
            }

            .search-card {
                padding: 1.5rem;
            }
            /* ... rest of your media query CSS ... */
        }

        @@media (max-width: 575.98px) {
            .tvet-hero {
                padding: 2.5rem 0;
            }

                .tvet-hero .display-4 {
                    font-size: 1.75rem;
                }

            .stat-number {
                font-size: 1.5rem;
            }

            .stat-label {
                font-size: 0.875rem;
            }

            .section-title {
                font-size: 1.5rem;
            }

            .program-modal-meta {
                flex-direction: column;
                gap: 0.5rem;
            }
        }
    </style>
    
</head>
<body>
    <!-- Header -->
    <header>
        <div class="container">
            <div class="header-content">
                <a asp-page="/Index" class="logo">
                    <div class="logo-text">Accreditation System</div>
                </a>
                <ul class="nav-links">
                    <li><a asp-page="/Explore">Explore</a></li>
                    <li><a asp-page="/Register">Register</a></li>
                    <li><a asp-page="/Services">Services</a></li>
                    <li><a asp-page="/Resources">Resources</a></li>
                    <li><a asp-page="/Help">Help</a></li>
                </ul>
                <div class="auth-buttons">
                    <div class="search-icon"><i class="fas fa-search"></i></div>
                    <div class="language-selector">EN</div>
                    <a asp-page="/Account/Login" class="login-btn">Log in</a>
                    <a asp-page="/Account/Register" class="signup-btn">Sign up</a>
                </div>
                <div class="menu-toggle"><i class="fas fa-bars"></i></div>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-content">
                <h1>Accreditation System</h1>
                <p>Empowering Excellence: Accredited Education for a Brighter Future</p>

                <div class="countdown">
                    <div class="countdown-item">
                        <div class="countdown-value">14</div>
                        <div class="countdown-label">Hours</div>
                    </div>
                    <div class="countdown-item">:</div>
                    <div class="countdown-item">
                        <div class="countdown-value">19</div>
                        <div class="countdown-label">Minutes</div>
                    </div>
                    <div class="countdown-item">:</div>
                    <div class="countdown-item">
                        <div class="countdown-value">36</div>
                        <div class="countdown-label">Seconds</div>
                    </div>
                </div>

                <a asp-page="NewSchoolRegistration" class="hero-btn">Apply Now</a>
            </div>
        </div>
    </section>

    <!-- Search Section -->
    <div class="container">
        <div class="search-section">
            <div class="search-tabs">
                <div class="search-tab active"><i class="fas fa-search"></i> Track Application</div>
                <div class="search-tab"><i class="fas fa-school"></i> School Registration</div>
                <div class="search-tab"><i class="fas fa-check-circle"></i> Accreditation Status</div>
                <div class="search-tab"><i class="fas fa-certificate"></i> Quality Check</div>
            </div>

            <div class="round-trip-options">
                <div class="trip-option">
                    <input type="radio" id="application-id" name="search-type" checked>
                    <label for="application-id">Application ID</label>
                </div>
                <div class="trip-option">
                    <input type="radio" id="school-name" name="search-type">
                    <label for="school-name">School Name</label>
                </div>
                <div class="trip-option">
                    <input type="radio" id="recent-applications" name="search-type">
                    <label for="recent-applications">Recent Applications</label>
                </div>
            </div>

            <form method="post" asp-page-handler="TrackApplication" class="search-form">
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="TrackingId">From</label>
                        <input asp-for="TrackingId" type="text" placeholder="Enter application ID or school name">
                        <span asp-validation-for="TrackingId" class="text-danger"></span>
                    </div>

                    <div class="destination-arrows">
                        <i class="fas fa-exchange-alt"></i>
                    </div>

                    <div class="form-group">
                        <label asp-for="StatusFilter">To</label>
                        <select asp-for="StatusFilter" asp-items="Model.StatusOptions">
                            <option value="">Select status</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group date-group">
                        <label>Start Date</label>
                        <div class="date-value">@Model.StartDate.ToString("dd MMM yyyy")</div>
                        <input asp-for="StartDate" type="hidden">
                    </div>

                    <div class="form-group date-group">
                        <label>End Date</label>
                        <div class="date-value">@Model.EndDate.ToString("dd MMM yyyy")</div>
                        <input asp-for="EndDate" type="hidden">
                    </div>

                    <div class="form-group">
                        <label asp-for="ApplicationTypeId">Application Type</label>
                        <select asp-for="ApplicationTypeId" asp-items="Model.ApplicationTypes">
                            <option value="">Select type</option>
                        </select>
                    </div>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                    <label class="trip-option">
                        <input asp-for="IncludeExpired" type="checkbox">
                        <span>Include expired applications</span>
                    </label>

                    <a href="#" class="promo-code-link">
                        <i class="fas fa-plus"></i> Add reference number
                    </a>
                </div>

                <button type="submit" class="search-btn">Search</button>
            </form>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="container">
        <div class="quick-links">
            <div class="quick-links-grid">
                @foreach (var quickLink in Model.QuickLinks)
                {
                    <a asp-page="@quickLink.Url" class="quick-link">
                        <i class="@quickLink.IconClass"></i>
                        <div class="quick-link-title">@quickLink.Title</div>
                    </a>
                }
            </div>
        </div>
    </div>


    <!-- Planning Section -->
    <section class="container">
        <h2 class="section-title">Start planning your next steps</h2>
        <div class="services-grid">
            @foreach (var service in Model.PlanningServices)
            {
                <div class="service-card">
                    <div class="service-img" style="background-image: url('@service.ImageUrl')">
                        <div class="service-img-overlay">
                            <div class="service-img-title">@service.Title</div>
                        </div>
                    </div>
                    <div class="service-content">
                        <p class="service-description">@service.Description</p>
                        <a asp-page="@service.Url" class="service-btn">@service.ButtonText</a>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Find Great Options Section -->
    <section class="container featured-destinations">
        <h2 class="section-title">Find great options</h2>
        <div class="services-grid">
            @foreach (var option in Model.EducationOptions)
            {
                <div class="service-card destination-card">
                    <img src="@option.ImageUrl" alt="@option.Title" class="destination-img">
                    <div class="destination-overlay">
                        <div class="destination-name">@option.Title</div>
                        <div class="destination-dates">@option.DateRange</div>
                        <div class="destination-price">@option.PriceInfo</div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Newsletter Section -->
    <section class="newsletter">
        <div class="container">
            <div class="newsletter-content">
                <div class="newsletter-text">
                    <h3>Never miss an update</h3>
                    <p>Subscribe and be the first to receive our exclusive updates on educational standards and accreditation opportunities.</p>
                </div>
                <form method="post" asp-page-handler="Subscribe" class="newsletter-form">
                    <input type="email" asp-for="SubscriberEmail" placeholder="Email address" required>
                    <span asp-validation-for="SubscriberEmail" class="text-danger"></span>

                    <input type="text" asp-for="SubscriberCity" placeholder="Preferred city">
                    <span asp-validation-for="SubscriberCity" class="text-danger"></span>

                    <div class="checkbox-group">
                        <input type="checkbox" asp-for="SubscriberConsent" id="newsletter-consent">
                        <label for="newsletter-consent">I would like to get offers and news from Accreditation System. I have read and understood the privacy notice.</label>
                        <span asp-validation-for="SubscriberConsent" class="text-danger"></span>
                    </div>
                    <button type="submit">Subscribe</button>
                </form>
            </div>
        </div>
    </section>

    <section class="achievements">
        <h2>Milestones & Achievements</h2>
        <div class="timeline">
            <div class="timeline-item">
                <div class="timeline-date">March 2025</div>
                <div class="timeline-title">Launched Our First Web App</div>
            </div>
            <div class="timeline-item">
                <div class="timeline-date">January 2024</div>
                <div class="timeline-title">Recognized for Innovation in Tech Education</div>
            </div>
            <div class="timeline-item">
                <div class="timeline-date">June 2023</div>
                <div class="timeline-title">Expanded Globally to 5 New Countries</div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="footer-content">
                @foreach (var column in Model.FooterColumns)
                {
                    <div class="footer-column">
                        <h4>@column.Title</h4>
                        <ul class="footer-links">
                            @foreach (var link in column.Links)
                            {
                                <li><a asp-page="@link.Url">@link.Text</a></li>
                            }
                        </ul>

                        @if (column.Title == "Help")
                        {
                            <h4>Let's stay connected</h4>
                            <div class="social-links">
                                <a href="#" class="social-icon"><i class="fab fa-facebook-f"></i></a>
                                <a href="#" class="social-icon"><i class="fab fa-twitter"></i></a>
                                <a href="#" class="social-icon"><i class="fab fa-linkedin-in"></i></a>
                                <a href="#" class="social-icon"><i class="fab fa-youtube"></i></a>
                                <a href="#" class="social-icon"><i class="fab fa-instagram"></i></a>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="footer-bottom">
                <div class="footer-bottom-links">
                    @foreach (var link in Model.FooterBottomLinks)
                    {
                        <a asp-page="@link.Url">@link.Text</a>
                    }
                </div>
                <p>Accreditation School System. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Countdown timer functionality
        function updateCountdown() {
            // Set a target date for the special offer
            const currentTime = new Date();
            const targetTime = new Date();
            targetTime.setHours(currentTime.getHours() + 14);
            targetTime.setMinutes(currentTime.getMinutes() + 19);
            targetTime.setSeconds(currentTime.getSeconds() + 36);

            // Calculate remaining time
            const timeRemaining = targetTime - currentTime;

            if (timeRemaining <= 0) {
                // Reset the countdown if expired
                document.querySelector('.countdown-item:nth-child(1) .countdown-value').textContent = "00";
                document.querySelector('.countdown-item:nth-child(3) .countdown-value').textContent = "00";
                document.querySelector('.countdown-item:nth-child(5) .countdown-value').textContent = "00";
                return;
            }

            // Calculate hours, minutes, seconds
            const hours = Math.floor(timeRemaining / (1000 * 60 * 60));
            const minutes = Math.floor((timeRemaining % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((timeRemaining % (1000 * 60)) / 1000);

            // Update the countdown display
            document.querySelector('.countdown-item:nth-child(1) .countdown-value').textContent = hours.toString().padStart(2, '0');
            document.querySelector('.countdown-item:nth-child(3) .countdown-value').textContent = minutes.toString().padStart(2, '0');
            document.querySelector('.countdown-item:nth-child(5) .countdown-value').textContent = seconds.toString().padStart(2, '0');
        }

        // Update countdown every second
        setInterval(updateCountdown, 1000);

        // Initialize countdown
        updateCountdown();

        // Tab switching functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Add smooth scrolling for all links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();

                    const targetId = this.getAttribute('href');
                    if (targetId === '#') return;

                    const targetElement = document.querySelector(targetId);
                    if (targetElement) {
                        targetElement.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });

            // Tab switching
            const searchTabs = document.querySelectorAll('.search-tab');
            searchTabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    // Remove active class from all tabs
                    searchTabs.forEach(t => t.classList.remove('active'));

                    // Add active class to clicked tab
                    this.classList.add('active');
                });
            });

            // Mobile menu toggle
            const menuToggle = document.querySelector('.menu-toggle');
            const navLinks = document.querySelector('.nav-links');
            const authButtons = document.querySelector('.auth-buttons');

            if (menuToggle) {
                menuToggle.addEventListener('click', function() {
                    navLinks.classList.toggle('mobile-visible');
                    authButtons.classList.toggle('mobile-visible');
                });
            }

            // Show success message if exists
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                        const successMessage = document.createElement('div');
                        successMessage.className = 'success-message';
                        successMessage.textContent = '@TempData["SuccessMessage"]';
                        document.body.appendChild(successMessage);

                        setTimeout(() => {
                            successMessage.style.opacity = '0';
                            successMessage.style.transform = 'translateX(100%)';
                            setTimeout(() => {
                                successMessage.remove();
                            }, 300);
                        }, 5000);
            </text>
        }

            // Animate sections on scroll
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('fade-in');
                        observer.unobserve(entry.target);
                    }
                });
            }, {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            });

            // Observe sections
            document.querySelectorAll('section, .quick-links, .search-section').forEach(section => {
                section.classList.add('fade-in-section');
                observer.observe(section);
            });
        });
    </script>
</body>
</html>