
@page
@model AccreditationSystem.Pages.Admin.SchoolsModel
@{
    ViewData["Title"] = "Schools";
}

@if (HttpContext.Session.GetInt32("UserId") == null)
{
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-body text-center p-5">
                        <div class="mb-4">
                            <i class="fas fa-lock fa-3x text-warning"></i>
                        </div>
                        <h2 class="card-title mb-3">Authentication Required</h2>
                        <p class="card-text mb-4">
                            You need to be logged in to access the Schools Management section.
                            Please sign in to continue.
                        </p>
                        <a href="/Auth/Login?ReturnUrl=@System.Net.WebUtility.UrlEncode($"/Admin/Schools")" 
                           class="btn btn-primary btn-lg px-5">
                            <i class="fas fa-sign-in-alt me-2"></i> Sign In
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container">
        <div class="row mb-4">
            <div class="col">
                <h1>Schools Management</h1>
                <p class="lead">View, add, edit, and manage schools in the system.</p>
            </div>
            <div class="col-auto align-self-center">
                <a asp-page="./CreateSchool" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Add New School
                </a>
            </div>
        </div>

        <!-- Search and Filter Section -->
        <div class="card mb-4">
            <div class="card-body">
                <form method="get">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="SearchString">Search</label>
                                <input type="text" asp-for="SearchString" class="form-control" placeholder="Search by name, location...">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="SchoolTypeFilter">School Type</label>
                                <select asp-for="SchoolTypeFilter" asp-items="Model.SchoolTypes" class="form-select">
                                    <option value="">All Types</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="LocationFilter">Location</label>
                                <select asp-for="LocationFilter" asp-items="Model.Locations" class="form-select">
                                    <option value="">All Locations</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-secondary w-100">
                                <i class="fas fa-filter"></i> Filter
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Schools Table -->
        <div class="card">
            <div class="card-body">
                @if (Model.SuccessMessage != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @Model.SuccessMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                
                @if (Model.ErrorMessage != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @Model.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (Model.Schools != null && Model.Schools.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>
                                        <a asp-page="./Schools" asp-route-sortOrder="@Model.NameSort">
                                            School Name
                                            @if (Model.CurrentSort == "name_asc")
                                            {
                                                <i class="fas fa-sort-up"></i>
                                            }
                                            else if (Model.CurrentSort == "name_desc")
                                            {
                                                <i class="fas fa-sort-down"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-sort"></i>
                                            }
                                        </a>
                                    </th>
                                    <th>Type</th>
                                    <th>
                                        <a asp-page="./Schools" asp-route-sortOrder="@Model.LocationSort">
                                            Location
                                            @if (Model.CurrentSort == "location_asc")
                                            {
                                                <i class="fas fa-sort-up"></i>
                                            }
                                            else if (Model.CurrentSort == "location_desc")
                                            {
                                                <i class="fas fa-sort-down"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-sort"></i>
                                            }
                                        </a>
                                    </th>
                                    <th>Year Established</th>
                                    <th>Students</th>
                                    <th>Staff</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var school in Model.Schools)
                                {
                                    <tr>
                                        <td>@school.school_name</td>
                                        <td>@school.school_type</td>
                                        <td>@school.city, @school.state_province</td>
                                        <td>@school.year_established</td>
                                        <td>@school.total_student_enrollment</td>
                                        <td>@school.number_of_teaching_staff</td>
                                        <td>
                                            @if (school.status == "Active")
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else if (school.status == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark">Pending</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a asp-page="./Details" asp-route-id="@school.id" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-page="./Edit" asp-route-id="@school.id" class="btn btn-sm btn-outline-secondary">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-page="./SubmitClaim" asp-route-id="@school.id" class="btn btn-sm btn-outline-info">
                                                    <i class="fas fa-certificate"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@school.id">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </div>

                                            <!-- Delete Confirmation Modal -->
                                            <div class="modal fade" id="deleteModal-@school.id" tabindex="-1" aria-labelledby="deleteModalLabel-@school.id" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="deleteModalLabel-@school.id">Confirm Delete</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            Are you sure you want to delete @school.school_name? This action cannot be undone.
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <form method="post">
                                                                <input type="hidden" name="id" value="@school.id" />
                                                                <button type="submit" class="btn btn-danger">Delete</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-page="./Schools" asp-route-pageIndex="1" asp-route-currentFilter="@Model.CurrentFilter">First</a>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" asp-page="./Schools" asp-route-pageIndex="@(Model.CurrentPage - 1)" asp-route-currentFilter="@Model.CurrentFilter">Previous</a>
                                    </li>
                                }

                                @for (var i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-page="./Schools" asp-route-pageIndex="@i" asp-route-currentFilter="@Model.CurrentFilter">@i</a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-page="./Schools" asp-route-pageIndex="@(Model.CurrentPage + 1)" asp-route-currentFilter="@Model.CurrentFilter">Next</a>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" asp-page="./Schools" asp-route-pageIndex="@Model.TotalPages" asp-route-currentFilter="@Model.CurrentFilter">Last</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <div class="alert alert-info text-center">
                        <h4>No schools found</h4>
                        <p>There are no schools that match your criteria. Try adjusting your filters or add a new school.</p>
                        <a asp-page="./CreateSchool" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Add New School
                        </a>
                    </div>
                }
            </div>
        </div>
        
        <!-- Action Buttons -->
        <div class="row mt-4 mb-5">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-file-alt text-primary me-2"></i>
                            Track Applications
                        </h5>
                        <p class="card-text">Check the status of accreditation applications and review their details.</p>
                        <a asp-page="./TrackApplication" class="btn btn-outline-primary">Track Application</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-certificate text-success me-2"></i>
                            Submit Accreditation Claim
                        </h5>
                        <p class="card-text">Apply for accreditation by submitting the required documentation and information.</p>
                        <a asp-page="./SubmitClaim" class="btn btn-outline-success">Submit Claim</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-chalkboard-teacher text-info me-2"></i>
                            Academic Combinations
                        </h5>
                        <p class="card-text">Browse available academic combinations for school accreditation assessments.</p>
                        <a asp-page="./GeneralCombination" class="btn btn-outline-info">View Combinations</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}