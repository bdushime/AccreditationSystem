@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var currentDate = DateTime.Now.ToString("dd MMMM yyyy");
    var currentUser = "Joshua";
}

<div class="welcome-banner p-4 mb-4 bg-light rounded-3 border-start border-5 border-primary">
    <div class="container-fluid py-2">
        <small class="text-muted d-block mb-2">@currentDate</small>
        <h3 class="fw-bold">Hi @currentUser</h3>
        <p class="text-secondary mb-0">We're glad you're back, check all the recent activities</p>
    </div>
</div>

<h2 class="mb-4 fw-bold">Dashboard</h2>

<div class="row g-4">
    <!-- Assigned Inspections -->
    <div class="col-md-4">
        <div class="card dashboard-card h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h5 class="card-title fw-bold mb-0">Assigned Inspections</h5>
                    <span class="badge bg-light text-dark">This month</span>
                </div>
                <div class="dashboard-stat text-primary">16</div>
                <div class="mt-3 d-flex justify-content-end">
                    <a href="#" class="btn btn-sm btn-outline-primary">
                        View <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Reviewed Applications -->
    <div class="col-md-4">
        <div class="card dashboard-card h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h5 class="card-title fw-bold mb-0">Reviewed Applications</h5>
                    <span class="badge bg-light text-dark">Total</span>
                </div>
                <div class="dashboard-stat text-primary">50</div>
                <div class="mt-3 d-flex justify-content-end">
                    <a href="#" class="btn btn-sm btn-outline-primary">
                        View <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Visited Schools -->
    <div class="col-md-4">
        <div class="card dashboard-card h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h5 class="card-title fw-bold mb-0">Visited Schools</h5>
                    <span class="badge bg-light text-dark">Total</span>
                </div>
                <div class="dashboard-stat text-primary">10</div>
                <div class="mt-3 d-flex justify-content-end">
                    <a href="#" class="btn btn-sm btn-outline-primary">
                        View <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-5">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="card-title fw-bold">Applications & Approvals</h5>
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-sm btn-outline-secondary active">Monthly</button>
                <button type="button" class="btn btn-sm btn-outline-secondary">Quarterly</button>
                <button type="button" class="btn btn-sm btn-outline-secondary">Yearly</button>
            </div>
        </div>

        <div class="chart-container">
            <canvas id="applicationsChart"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('applicationsChart').getContext('2d');

            const data = {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                datasets: [
                    {
                        label: 'Applications',
                        data: [35, 45, 62, 58, 70, 60, 65, 68, 78, 82, 95, 98],
                        backgroundColor: 'rgba(13, 110, 253, 0.8)',
                        borderColor: 'rgba(13, 110, 253, 1)',
                        borderWidth: 1
                    },
                    {
                        label: 'Approvals',
                        data: [30, 38, 55, 45, 60, 48, 58, 60, 65, 70, 75, 80],
                        backgroundColor: 'rgba(40, 167, 69, 0.8)',
                        borderColor: 'rgba(40, 167, 69, 1)',
                        borderWidth: 1
                    }
                ]
            };

            const myChart = new Chart(ctx, {
                type: 'bar',
                data: data,
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 120
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    }
                }
            });
        });
    </script>
}