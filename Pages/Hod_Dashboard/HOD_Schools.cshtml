@page
@model AccreditationSystem.Pages.Hod_Dashboard.SchoolsModel
@{
    ViewData["Title"] = "Schools - Accreditation System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Include Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
    <!-- Header/Navigation Bar -->
    <header class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <!-- Logo -->
                <div class="flex items-center flex-shrink-0">
                    <a href="#" class="text-indigo-600 font-bold text-xl">Accreditation</a>
                </div>

                <!-- Center Navigation -->
                <nav class="hidden md:flex space-x-8 items-center">
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_HOME" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Home</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Applications" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Applications</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Schools" class="text-indigo-600 border-b-2 border-indigo-600 px-3 py-2 text-sm font-medium">Schools</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Inspections" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Inspections</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Claims" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Claims</a>
                </nav>

                <!-- User menu -->
                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-2">
                        <span class="bg-gray-200 text-gray-700 rounded-full h-8 w-8 flex items-center justify-center text-sm font-medium">JK</span>
                        <span class="text-gray-700 font-medium">HOD</span>
                    </div>
                    <button class="bg-red-500 hover:bg-red-300 text-black font-semibold py-2 text-white px-4 border border-gray-300 rounded shadow-sm text-sm">
                        <a href="/">Sign out</a>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
        <!-- Schools List Header -->
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-900">List Of Schools</h1>

            <!-- Search Bar -->
            <div class="relative w-64">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                    </svg>
                </div>
                <input type="text" name="search" id="search" placeholder="Search" class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
            </div>
        </div>

        <!-- Schools Table -->
        <div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider cursor-pointer">
                            <div class="flex items-center">
                                Email
                                <svg class="ml-1 w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                </svg>
                            </div>
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Name
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Type
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Phone
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Address
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Status
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var school in Model.Schools)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900">@school.school_email</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900">@school.school_name</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900">@school.school_type</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900">@school.school_phone</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900">
                                    @school.address_line_1
                                    @if (!string.IsNullOrEmpty(school.address_line_2))
                                    {
                                        <span>, @school.address_line_2</span>
                                    }
                                    <span>, @school.city, @school.state_province</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                  @(school.status.ToLower() == "active" ? "bg-green-100 text-green-800" :
                    school.status.ToLower() == "pending" ? "bg-yellow-100 text-yellow-800" :
                    school.status.ToLower() == "inactive" ? "bg-red-100 text-red-800" :
                    "bg-gray-100 text-gray-800")">
                                    @school.status
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <a href="/Hod_Dashboard/SchoolDetails?id=@school.id" class="text-indigo-600 hover:text-indigo-900">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <!-- Pagination -->
        <div class="mt-4 flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-700">
                    Showing <span class="font-medium">@((Model.PageNumber - 1) * Model.PageSize + 1)</span> to
                    <span class="font-medium">@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalSchools))</span> of
                    <span class="font-medium">@Model.TotalSchools</span> schools
                </p>
            </div>
            <div class="flex items-center space-x-2">
                @if (Model.PageNumber > 1)
                {
                    <a href="/Hod_Dashboard/HOD_Schools?PageNumber=@(Model.PageNumber-1)"
                       class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                        <svg class="h-5 w-5 mr-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                        Prev
                    </a>
                }
                else
                {
                    <span class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-400 bg-gray-100 cursor-not-allowed">
                        <svg class="h-5 w-5 mr-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                        Prev
                    </span>
                }

                @{
                    int startPage = Math.Max(1, Model.PageNumber - 2);
                    int endPage = Math.Min(Model.TotalPages, startPage + 4);
                    startPage = Math.Max(1, endPage - 4);
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    if (i == Model.PageNumber)
                    {
                        <span class="relative inline-flex items-center px-4 py-2 border border-indigo-500 text-sm font-medium rounded-md text-white bg-indigo-600">
                            @i
                        </span>
                    }
                    else
                    {
                        <a href="/Hod_Dashboard/HOD_Schools?PageNumber=@i"
                           class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                            @i
                        </a>
                    }
                }

                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a href="/Hod_Dashboard/HOD_Schools?PageNumber=@(Model.PageNumber+1)"
                       class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                        Next
                        <svg class="h-5 w-5 ml-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                        </svg>
                    </a>
                }
                else
                {
                    <span class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-400 bg-gray-100 cursor-not-allowed">
                        Next
                        <svg class="h-5 w-5 ml-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                        </svg>
                    </span>
                }
            </div>
        </div>
    </main>
</body>
</html>