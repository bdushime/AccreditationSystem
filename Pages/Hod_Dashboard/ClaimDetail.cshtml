@page
@model AccreditationSystem.Pages.Hod_Dashboard.ClaimDetailsModel
@{
    ViewData["Title"] = "Claim Details - Accreditation System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Include Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
    <!-- Header/Navigation Bar -->
    <header class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <!-- Logo -->
                <div class="flex items-center flex-shrink-0">
                    <a href="#" class="text-indigo-600 font-bold text-xl">Accreditation</a>
                </div>

                <!-- Center Navigation -->
                <nav class="hidden md:flex space-x-8 items-center">
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_HOME" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Home</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Applications" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Applications</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Schools" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Schools</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Inspections" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Inspections</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Claims" class="text-indigo-600 border-b-2 border-indigo-600 px-3 py-2 text-sm font-medium">Claims</a>
                </nav>

                <!-- User menu -->
                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-2">
                        <span class="bg-gray-200 text-gray-700 rounded-full h-8 w-8 flex items-center justify-center text-sm font-medium">JK</span>
                        <span class="text-gray-700 font-medium">HOD</span>
                    </div>
                    <button class="bg-red-500 hover:bg-red-300 text-black font-semibold py-2 text-white px-4 border border-gray-300 rounded shadow-sm text-sm">
                        <a href="/">Sign out</a>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
        <!-- Back Button -->
        <div class="mb-6">
            <a href="/Hod_Dashboard/HOD_Claims" class="inline-flex items-center text-indigo-600 hover:text-indigo-900">
                <svg class="h-5 w-5 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                Back to Claims
            </a>
        </div>

        <!-- Error Message Display -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert">
                <span class="block sm:inline">@TempData["ErrorMessage"]</span>
            </div>
        }

        <!-- Claim Not Found -->
        @if (Model.Claim == null)
        {
            <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded mb-4" role="alert">
                <span class="block sm:inline">Claim not found or has been deleted.</span>
            </div>
        }
        else
        {
            <!-- Claim Header -->
            <div class="bg-white shadow overflow-hidden sm:rounded-lg mb-6">
                <div class="px-4 py-5 sm:px-6 flex justify-between items-center">
                    <div>
                        <h1 class="text-2xl font-bold text-gray-900">Claim Details</h1>
                        <p class="mt-1 max-w-2xl text-sm text-gray-500">Claim ID: #@Model.Claim.ClaimID</p>
                    </div>

                    <div>
                        @{
                            string statusColorClass = "bg-blue-100 text-blue-800";
                            if (Model.Claim.Status == "Approved")
                            {
                                statusColorClass = "bg-green-100 text-green-800";
                            }
                            else if (Model.Claim.Status == "Rejected")
                            {
                                statusColorClass = "bg-red-100 text-red-800";
                            }
                            else if (Model.Claim.Status == "Submitted")
                            {
                                statusColorClass = "bg-yellow-100 text-yellow-800";
                            }
                        }
                        <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full @statusColorClass">
                            @Model.Claim.Status
                        </span>
                    </div>
                </div>

                <!-- School Information Section -->
                <div class="border-t border-gray-200">
                    <dl>
                        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">School Email</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">@Model.Claim.SchoolEmail</dd>
                        </div>
                        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Accreditation Type</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">@Model.Claim.AccreditationType</dd>
                        </div>
                        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Accreditation Level</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">@Model.Claim.AccreditationLevel</dd>
                        </div>
                        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Previous Status</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                @(string.IsNullOrEmpty(Model.Claim.PreviousStatus) ? "N/A" : Model.Claim.PreviousStatus)
                            </dd>
                        </div>
                        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Accreditation Period</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                @Model.Claim.StartDate.ToString("MMM dd, yyyy") - @Model.Claim.EndDate.ToString("MMM dd, yyyy")
                            </dd>
                        </div>
                        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Submission Date</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                @Model.Claim.SubmissionDate.ToString("MMM dd, yyyy HH:mm")
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            <!-- Contact Information -->
            <div class="bg-white shadow overflow-hidden sm:rounded-lg mb-6">
                <div class="px-4 py-5 sm:px-6">
                    <h2 class="text-lg font-medium text-gray-900">Contact Information</h2>
                    <p class="mt-1 max-w-2xl text-sm text-gray-500">School contact details for this claim</p>
                </div>

                <div class="border-t border-gray-200">
                    <dl>
                        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Contact Name</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                @(string.IsNullOrEmpty(Model.Claim.ContactName) ? "N/A" : Model.Claim.ContactName)
                            </dd>
                        </div>
                        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Position</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                @(string.IsNullOrEmpty(Model.Claim.ContactPosition) ? "N/A" : Model.Claim.ContactPosition)
                            </dd>
                        </div>
                        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Email</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                @(string.IsNullOrEmpty(Model.Claim.ContactEmail) ? "N/A" : Model.Claim.ContactEmail)
                            </dd>
                        </div>
                        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Phone</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                @(string.IsNullOrEmpty(Model.Claim.ContactPhone) ? "N/A" : Model.Claim.ContactPhone)
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            <!-- Academic Standards and Comments -->
            <div class="bg-white shadow overflow-hidden sm:rounded-lg mb-6">
                <div class="px-4 py-5 sm:px-6">
                    <h2 class="text-lg font-medium text-gray-900">Accreditation Standards</h2>
                    <p class="mt-1 max-w-2xl text-sm text-gray-500">Self-reported standards and assessments</p>
                </div>

                <div class="border-t border-gray-200">
                    <dl>
                        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Academic Standards</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                @(string.IsNullOrEmpty(Model.Claim.AcademicStandards) ? "Not specified" : Model.Claim.AcademicStandards)
                            </dd>
                        </div>
                        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Faculty Standards</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                @(string.IsNullOrEmpty(Model.Claim.FacultyStandards) ? "Not specified" : Model.Claim.FacultyStandards)
                            </dd>
                        </div>
                        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Facility Standards</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                @(string.IsNullOrEmpty(Model.Claim.FacilityStandards) ? "Not specified" : Model.Claim.FacilityStandards)
                            </dd>
                        </div>
                        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Student Services</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                @(string.IsNullOrEmpty(Model.Claim.StudentServices) ? "Not specified" : Model.Claim.StudentServices)
                            </dd>
                        </div>
                        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Additional Comments</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                @(string.IsNullOrEmpty(Model.Claim.AdditionalComments) ? "No additional comments" : Model.Claim.AdditionalComments)
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            <!-- Documentation Section -->
            <div class="bg-white shadow overflow-hidden sm:rounded-lg mb-6">
                <div class="px-4 py-5 sm:px-6">
                    <h2 class="text-lg font-medium text-gray-900">Attached Documentation</h2>
                    <p class="mt-1 max-w-2xl text-sm text-gray-500">Supporting documents submitted with this claim</p>
                </div>

                <div class="border-t border-gray-200">
                    <dl>
                        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Self-Assessment Report</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                @if (!string.IsNullOrEmpty(Model.Claim.SelfAssessmentReportPath))
                                {
                                    <a href="@Model.Claim.SelfAssessmentReportPath" target="_blank" class="text-indigo-600 hover:text-indigo-900">
                                        View Document
                                        <svg class="inline-block ml-1 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                        </svg>
                                    </a>
                                }
                                else
                                {
                                    <span>No document attached</span>
                                }
                            </dd>
                        </div>
                        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Curriculum Documentation</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                @if (!string.IsNullOrEmpty(Model.Claim.CurriculumDocumentationPath))
                                {
                                    <a href="@Model.Claim.CurriculumDocumentationPath" target="_blank" class="text-indigo-600 hover:text-indigo-900">
                                        View Document
                                        <svg class="inline-block ml-1 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                        </svg>
                                    </a>
                                }
                                else
                                {
                                    <span>No document attached</span>
                                }
                            </dd>
                        </div>
                        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Faculty Credentials</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                @if (!string.IsNullOrEmpty(Model.Claim.FacultyCredentialsPath))
                                {
                                    <a href="@Model.Claim.FacultyCredentialsPath" target="_blank" class="text-indigo-600 hover:text-indigo-900">
                                        View Document
                                        <svg class="inline-block ml-1 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                        </svg>
                                    </a>
                                }
                                else
                                {
                                    <span>No document attached</span>
                                }
                            </dd>
                        </div>
                        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                            <dt class="text-sm font-medium text-gray-500">Additional Documentation</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                @if (!string.IsNullOrEmpty(Model.Claim.AdditionalDocumentationPath))
                                {
                                    <a href="@Model.Claim.AdditionalDocumentationPath" target="_blank" class="text-indigo-600 hover:text-indigo-900">
                                        View Document
                                        <svg class="inline-block ml-1 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                        </svg>
                                    </a>
                                }
                                else
                                {
                                    <span>No document attached</span>
                                }
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            <!-- Review Information (if reviewed) -->
            @if (!string.IsNullOrEmpty(Model.Claim.ReviewerID) || !string.IsNullOrEmpty(Model.Claim.ReviewNotes))
            {
                <div class="bg-white shadow overflow-hidden sm:rounded-lg mb-6">
                    <div class="px-4 py-5 sm:px-6">
                        <h2 class="text-lg font-medium text-gray-900">Review Information</h2>
                        <p class="mt-1 max-w-2xl text-sm text-gray-500">Review details and notes</p>
                    </div>

                    <div class="border-t border-gray-200">
                        <dl>
                            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                                <dt class="text-sm font-medium text-gray-500">Reviewer ID</dt>
                                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                    @(string.IsNullOrEmpty(Model.Claim.ReviewerID) ? "Not yet reviewed" : Model.Claim.ReviewerID)
                                </dd>
                            </div>
                            <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                                <dt class="text-sm font-medium text-gray-500">Review Date</dt>
                                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                    @(Model.Claim.ReviewDate.HasValue ? Model.Claim.ReviewDate.Value.ToString("MMM dd, yyyy") : "Not yet reviewed")
                                </dd>
                            </div>
                            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                                <dt class="text-sm font-medium text-gray-500">Review Notes</dt>
                                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                    @(string.IsNullOrEmpty(Model.Claim.ReviewNotes) ? "No review notes provided" : Model.Claim.ReviewNotes)
                                </dd>
                            </div>
                        </dl>
                    </div>
                </div>
            }

            <!-- Action Buttons -->
            <div class="flex justify-end space-x-4 mt-6">
                <a href="/Hod_Dashboard/ClaimEdit?id=@Model.Claim.ClaimID" class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Edit Claim
                </a>
                @if (Model.Claim.Status == "Submitted")
                {
                    <form method="post">
                        <input type="hidden" name="id" value="@Model.Claim.ClaimID" />
                        <button type="submit" asp-page-handler="Approve" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
                            Approve Claim
                        </button>
                        <button type="submit" asp-page-handler="Reject" class="ml-3 inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                            Reject Claim
                        </button>
                    </form>
                }
            </div>
        }
    </main>
</body>
</html>