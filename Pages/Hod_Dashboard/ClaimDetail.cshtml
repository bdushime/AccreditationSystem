@page
@model AccreditationSystem.Pages.Hod_Dashboard.ClaimDetailModel

@{
    ViewData["Title"] = "Accreditation Claim Details";
}

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        jakarta: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                        },
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
}

<div class="container mx-auto px-4 py-8">
    <!-- Success/Error messages -->
    @if (!string.IsNullOrEmpty(TempData["SuccessMessage"] as string))
    {
        <div class="mb-6 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" role="alert">
            <span class="block sm:inline">@TempData["SuccessMessage"]</span>
            <button class="absolute top-0 bottom-0 right-0 px-4 py-3" onclick="this.parentElement.style.display='none'">
                <svg class="h-6 w-6 text-green-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(TempData["ErrorMessage"] as string))
    {
        <div class="mb-6 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
            <span class="block sm:inline">@TempData["ErrorMessage"]</span>
            <button class="absolute top-0 bottom-0 right-0 px-4 py-3" onclick="this.parentElement.style.display='none'">
                <svg class="h-6 w-6 text-red-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    }

    <!-- Breadcrumb -->
    <nav class="flex mb-5" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a href="/Hod_Dashboard/HOD_Home" class="text-gray-700 hover:text-primary-600">
                    <svg class="w-5 h-5 mr-2.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
                    </svg>
                    Dashboard
                </a>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    <a href="/Hod_Dashboard/HOD_Claims" class="ml-1 text-gray-700 hover:text-primary-600 md:ml-2">Claims</a>
                </div>
            </li>
            <li aria-current="page">
                <div class="flex items-center">
                    <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="ml-1 text-gray-500 md:ml-2">Claim #@Model.Claim.ClaimID</span>
                </div>
            </li>
        </ol>
    </nav>

    <!-- Page Title and Status Badge -->
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Accreditation Claim #@Model.Claim.ClaimID</h1>
        <div>
            @{
                string statusClass = "";
                switch (Model.Claim.Status.ToLower())
                {
                    case "pending":
                    case "submitted":
                        statusClass = "bg-yellow-100 text-yellow-800";
                        break;
                    case "approved":
                        statusClass = "bg-green-100 text-green-800";
                        break;
                    case "rejected":
                        statusClass = "bg-red-100 text-red-800";
                        break;
                    default:
                        statusClass = "bg-gray-100 text-gray-800";
                        break;
                }
            }
            <span class="px-3 py-1 @statusClass rounded-full text-sm font-medium">
                @Model.Claim.Status
            </span>
        </div>
    </div>

    <!-- Claim Details Card -->
    <div class="bg-white shadow-md rounded-lg overflow-hidden mb-8">
        <div class="bg-primary-700 px-6 py-4">
            <h2 class="text-xl font-semibold text-white">Claim Information</h2>
        </div>

        <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Left Column -->
                <div>
                    <h3 class="text-lg font-medium text-gray-800 mb-4">General Information</h3>

                    <div class="mb-4">
                        <p class="text-sm text-gray-500">School Email</p>
                        <p class="font-medium">@Model.Claim.SchoolEmail</p>
                    </div>

                    <div class="mb-4">
                        <p class="text-sm text-gray-500">Accreditation Type</p>
                        <p class="font-medium">@Model.Claim.AccreditationType</p>
                    </div>

                    <div class="mb-4">
                        <p class="text-sm text-gray-500">Accreditation Level</p>
                        <p class="font-medium">@Model.Claim.AccreditationLevel</p>
                    </div>

                    <div class="mb-4">
                        <p class="text-sm text-gray-500">Previous Status</p>
                        <p class="font-medium">@(string.IsNullOrEmpty(Model.Claim.PreviousStatus) ? "N/A" : Model.Claim.PreviousStatus)</p>
                    </div>

                    <div class="mb-4">
                        <p class="text-sm text-gray-500">Requested Period</p>
                        <p class="font-medium">@Model.Claim.StartDate.ToShortDateString() to @Model.Claim.EndDate.ToShortDateString()</p>
                    </div>
                </div>

                <!-- Right Column -->
                <div>
                    <h3 class="text-lg font-medium text-gray-800 mb-4">Contact Information</h3>

                    <div class="mb-4">
                        <p class="text-sm text-gray-500">Contact Name</p>
                        <p class="font-medium">@Model.Claim.ContactName</p>
                    </div>

                    <div class="mb-4">
                        <p class="text-sm text-gray-500">Position/Title</p>
                        <p class="font-medium">@Model.Claim.ContactPosition</p>
                    </div>

                    <div class="mb-4">
                        <p class="text-sm text-gray-500">Contact Email</p>
                        <p class="font-medium">@Model.Claim.ContactEmail</p>
                    </div>

                    <div class="mb-4">
                        <p class="text-sm text-gray-500">Contact Phone</p>
                        <p class="font-medium">@Model.Claim.ContactPhone</p>
                    </div>

                    <div class="mb-4">
                        <p class="text-sm text-gray-500">Submission Date</p>
                        <p class="font-medium">@Model.Claim.SubmissionDate.ToString("MMMM dd, yyyy")</p>
                    </div>
                </div>
            </div>

            <!-- Academic Standards -->
            <div class="mt-8">
                <h3 class="text-lg font-medium text-gray-800 mb-4">Standards Compliance</h3>

                <div class="bg-gray-50 p-4 rounded-md mb-4">
                    <h4 class="font-medium mb-2">Academic Excellence Standards</h4>
                    <p>@Model.Claim.AcademicStandards</p>
                </div>

                <div class="bg-gray-50 p-4 rounded-md mb-4">
                    <h4 class="font-medium mb-2">Faculty Qualifications Standards</h4>
                    <p>@Model.Claim.FacultyStandards</p>
                </div>

                <div class="bg-gray-50 p-4 rounded-md mb-4">
                    <h4 class="font-medium mb-2">Facility Standards</h4>
                    <p>@Model.Claim.FacilityStandards</p>
                </div>

                <div class="bg-gray-50 p-4 rounded-md mb-4">
                    <h4 class="font-medium mb-2">Student Services Standards</h4>
                    <p>@Model.Claim.StudentServices</p>
                </div>
            </div>

            <!-- Additional Comments Section -->
            <div class="mt-6">
                <h3 class="text-lg font-medium text-gray-800 mb-2">Additional Comments</h3>
                <div class="p-4 bg-gray-50 rounded-md">
                    <p>@(string.IsNullOrEmpty(Model.Claim.AdditionalComments) ? "No additional comments provided." : Model.Claim.AdditionalComments)</p>
                </div>
            </div>

            <!-- Attached Documents Section -->
            <div class="mt-6">
                <h3 class="text-lg font-medium text-gray-800 mb-2">Attached Documents</h3>
                <div class="bg-gray-50 p-4 rounded-md">
                    <ul class="divide-y divide-gray-200">
                        @if (!string.IsNullOrEmpty(Model.Claim.SelfAssessmentReportPath))
                        {
                            <li class="py-3 flex justify-between">
                                <div class="flex items-center">
                                    <svg class="h-5 w-5 text-gray-400 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                    </svg>
                                    <span>Self-Assessment Report</span>
                                </div>
                                <a href="/Hod_Dashboard/DownloadDocument?path=@Model.Claim.SelfAssessmentReportPath" class="text-primary-600 hover:text-primary-800">
                                    Download
                                </a>
                            </li>
                        }

                        @if (!string.IsNullOrEmpty(Model.Claim.CurriculumDocumentationPath))
                        {
                            <li class="py-3 flex justify-between">
                                <div class="flex items-center">
                                    <svg class="h-5 w-5 text-gray-400 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                    </svg>
                                    <span>Curriculum Documentation</span>
                                </div>
                                <a href="/Hod_Dashboard/DownloadDocument?path=@Model.Claim.CurriculumDocumentationPath" class="text-primary-600 hover:text-primary-800">
                                    Download
                                </a>
                            </li>
                        }

                        @if (!string.IsNullOrEmpty(Model.Claim.FacultyCredentialsPath))
                        {
                            <li class="py-3 flex justify-between">
                                <div class="flex items-center">
                                    <svg class="h-5 w-5 text-gray-400 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                    </svg>
                                    <span>Faculty Credentials</span>
                                </div>
                                <a href="/Hod_Dashboard/DownloadDocument?path=@Model.Claim.FacultyCredentialsPath" class="text-primary-600 hover:text-primary-800">
                                    Download
                                </a>
                            </li>
                        }

                        @if (!string.IsNullOrEmpty(Model.Claim.AdditionalDocumentationPath))
                        {
                            <li class="py-3 flex justify-between">
                                <div class="flex items-center">
                                    <svg class="h-5 w-5 text-gray-400 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                    </svg>
                                    <span>Additional Documentation</span>
                                </div>
                                <a href="/Hod_Dashboard/DownloadDocument?path=@Model.Claim.AdditionalDocumentationPath" class="text-primary-600 hover:text-primary-800">
                                    Download
                                </a>
                            </li>
                        }

                        @if (string.IsNullOrEmpty(Model.Claim.SelfAssessmentReportPath) &&
                        string.IsNullOrEmpty(Model.Claim.CurriculumDocumentationPath) &&
                        string.IsNullOrEmpty(Model.Claim.FacultyCredentialsPath) &&
                        string.IsNullOrEmpty(Model.Claim.AdditionalDocumentationPath))
                        {
                            <li class="py-3">No documents found.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Review Section -->
    @if (Model.Claim.Status.ToLower() == "pending" || Model.Claim.Status.ToLower() == "submitted")
    {
        <div class="bg-white shadow-md rounded-lg overflow-hidden">
            <div class="bg-primary-700 px-6 py-4">
                <h2 class="text-xl font-semibold text-white">Review Decision</h2>
            </div>

            <div class="p-6">
                <p class="mb-4">Please provide feedback and make a decision on this accreditation claim.</p>

                <form method="post">
                    <input type="hidden" name="id" value="@Model.Claim.ClaimID" />
                    
                    <div class="mb-6">
                        <label for="Feedback" class="block text-sm font-medium text-gray-700 mb-2">Feedback <span class="text-red-500">*</span></label>
                        <textarea id="Feedback" name="Feedback" rows="6" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" placeholder="Provide detailed feedback on your decision. If rejecting, explain the reasons clearly..."></textarea>
                        <p class="mt-1 text-sm text-gray-500">This feedback will be included in the email notification sent to the school.</p>
                    </div>

                    <div class="flex justify-between">
                        <a href="/Hod_Dashboard/HOD_Claims" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                            Back to List
                        </a>

                        <div class="flex space-x-4">
                            <button type="submit" asp-page-handler="Reject" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" onclick="return confirm('Are you sure you want to reject this claim?');">
                                <svg class="mr-2 -ml-1 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                                Reject
                            </button>

                            <button type="submit" asp-page-handler="Approve" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" onclick="return confirm('Are you sure you want to approve this claim?');">
                                <svg class="mr-2 -ml-1 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                Approve
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        <!-- Previous Decision Details -->
        <div class="bg-white shadow-md rounded-lg overflow-hidden">
            <div class="bg-primary-700 px-6 py-4">
                <h2 class="text-xl font-semibold text-white">Decision Details</h2>
            </div>

            <div class="p-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <p class="text-sm text-gray-500">Status</p>
                        <p class="font-medium">@Model.Claim.Status</p>
                    </div>

                    <div>
                        <p class="text-sm text-gray-500">Decision Date</p>
                        <p class="font-medium">
                            @if (Model.Claim.Status.ToLower() == "approved" && Model.Claim.ApprovalDate.HasValue)
                            {
                                @Model.Claim.ApprovalDate.Value.ToString("MMMM dd, yyyy")
                            }
                            else if (Model.Claim.Status.ToLower() == "rejected" && Model.Claim.ReviewDate.HasValue)
                            {
                                @Model.Claim.ReviewDate.Value.ToString("MMMM dd, yyyy")
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </p>
                    </div>
                </div>

                <div class="mt-4">
                    <p class="text-sm text-gray-500 mb-1">Review Notes</p>
                    <div class="p-4 bg-gray-50 rounded-md">
                        <p>@(string.IsNullOrEmpty(Model.Claim.ReviewNotes) ? "No review notes provided." : Model.Claim.ReviewNotes)</p>
                    </div>
                </div>

                <div class="mt-6 text-right">
                    <a href="/Hod_Dashboard/HOD_Claims" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                        Back to List
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<script>
    // Validate form submission
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', function(event) {
                const feedback = document.getElementById('Feedback').value.trim();
                if (!feedback) {
                    event.preventDefault();
                    alert('Please provide feedback for your decision.');
                    document.getElementById('Feedback').focus();
                }
            });
        }
    });
</script>