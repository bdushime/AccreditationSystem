@page
@model AccreditationSystem.Pages.Hod_Dashboard.HOD_ApprovedSchoolsModel

@{
    ViewData["Title"] = "Approved Schools - Accreditation System";
}

<div class="w-full min-h-screen bg-gray-50">
    <!-- Header/Navigation Bar -->
    <header class="bg-white shadow-sm border-b border-gray-200">
        <div class="w-full mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <!-- Logo -->
                <div class="flex items-center flex-shrink-0">
                    <a href="#" class="text-indigo-600 font-bold text-xl">Accreditation</a>
                </div>

                <!-- Center Navigation -->
                <nav class="hidden md:flex space-x-8 items-center">
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_HOME" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Home</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Applications" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Applications</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_ApprovedSchools" class="text-indigo-600 border-b-2 border-indigo-600 px-3 py-2 text-sm font-medium">Approved Schools</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Inspections" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Inspections</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Claims" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Claims</a>
                </nav>

                <!-- User menu -->
                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-2">
                        <span class="bg-gray-200 text-gray-700 rounded-full h-8 w-8 flex items-center justify-center text-sm font-medium">JK</span>
                        <span class="text-gray-700 font-medium">HOD</span>
                    </div>
                    <button class="bg-red-500 hover:bg-red-300 text-black font-semibold py-2 text-white px-4 border border-gray-300 rounded shadow-sm text-sm">
                        <a href="/">Sign out</a>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="w-full mx-auto py-6 sm:px-6 lg:px-8">
        <!-- Page Title -->
        <div class="pb-4 border-b border-gray-200">
            <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">Approved Schools & Certificate Management</h2>
            <p class="mt-1 text-sm text-gray-600">Manage certificates for approved accreditation applications</p>
        </div>

        <!-- Success/Error Messages -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mt-4 p-4 bg-red-100 text-red-700 rounded-md">
                @TempData["ErrorMessage"]
            </div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mt-4 p-4 bg-green-100 text-green-700 rounded-md">
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Filters and Search -->
        <div class="mt-6">
            <div class="sm:flex sm:items-center sm:justify-between">
                <div class="sm:flex-auto">
                    <h3 class="text-lg font-semibold text-gray-900">Approved Schools</h3>
                    <p class="mt-1 text-sm text-gray-600">Total: @Model.TotalRecords schools approved</p>
                </div>
                <div class="mt-4 sm:mt-0 sm:flex sm:items-center sm:space-x-4">
                    <!-- Search Bar -->
                    <div class="relative">
                        <input type="text" id="searchInput" placeholder="Search schools..."
                               class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                            </svg>
                        </div>
                    </div>

                    <!-- Trade Filter -->
                    <select id="tradeFilter" class="block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                        <option value="">All Programs</option>
                        @{
                            var uniqueTrades = Model.ApprovedSchools
                            .Select(s => s.Trade)
                            .Distinct()
                            .OrderBy(t => t);

                            foreach (var trade in uniqueTrades)
                            {
                                <option value="@trade">@trade</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <!-- Table -->
            <div class="mt-4 flex flex-col">
                <div class="-my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
                    <div class="py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8">
                        <div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            Institution
                                        </th>
                                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            Program
                                        </th>
                                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            Contact
                                        </th>
                                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            Approval Date
                                        </th>
                                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            Certificate Status
                                        </th>
                                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            Actions
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="schoolsTableBody" class="bg-white divide-y divide-gray-200">
                                    @foreach (var school in Model.ApprovedSchools)
                                    {
                                        <tr class="school-row" data-trade="@school.Trade" data-name="@school.InstitutionName" data-email="@school.Email">
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <div class="flex items-center">
                                                    <div class="flex-shrink-0 h-10 w-10">
                                                        <div class="h-10 w-10 rounded-full bg-indigo-100 flex items-center justify-center">
                                                            <span class="text-sm font-medium text-indigo-800">
                                                                @(string.IsNullOrEmpty(school.InstitutionName) ? "?" : school.InstitutionName.Substring(0, 1))
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="ml-4">
                                                        <div class="text-sm font-medium text-gray-900">@school.InstitutionName</div>
                                                        <div class="text-sm text-gray-500">@school.Email</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <div class="text-sm text-gray-900">@school.Trade</div>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <div class="text-sm text-gray-900">@(string.IsNullOrEmpty(school.ContactPerson) ? "N/A" : school.ContactPerson)</div>
                                                <div class="text-sm text-gray-500">@(string.IsNullOrEmpty(school.PhoneNumber) ? "" : school.PhoneNumber)</div>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <div class="text-sm text-gray-900">
                                                    @(school.ApprovalDate?.ToString("MMM dd, yyyy") ?? "N/A")
                                                </div>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                                    Pending Certificate
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                                <div class="flex space-x-2">
                                                    <form method="post" class="inline">
                                                        <button type="submit" asp-page-handler="GenerateCertificate" asp-route-schoolId="@school.ID"
                                                                class="text-indigo-600 hover:text-indigo-900 bg-indigo-50 hover:bg-indigo-100 px-3 py-1 rounded text-sm font-medium"
                                                                onclick="return confirm('Generate certificate for @school.InstitutionName?')">
                                                            Generate Certificate
                                                        </button>
                                                    </form>
                                                    <a href="/Hod_Dashboard/CertificateView?applicationId=@school.ID"
                                                       class="text-green-600 hover:text-green-900 bg-green-50 hover:bg-green-100 px-3 py-1 rounded text-sm font-medium">
                                                        View Details
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pagination -->
            <div class="mt-6 flex items-center justify-between">
                <div class="flex-1 flex justify-between sm:hidden">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-page="/Hod_Dashboard/HOD_ApprovedSchools" asp-route-currentPage="@(Model.CurrentPage - 1)"
                           class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                            Previous
                        </a>
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a asp-page="/Hod_Dashboard/HOD_ApprovedSchools" asp-route-currentPage="@(Model.CurrentPage + 1)"
                           class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                            Next
                        </a>
                    }
                </div>
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-gray-700">
                            Showing <span class="font-medium">@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</span> to
                            <span class="font-medium">@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords)</span> of
                            <span class="font-medium">@Model.TotalRecords</span> results
                        </p>
                    </div>
                    <div>
                        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                            @if (Model.CurrentPage > 1)
                            {
                                <a asp-page="/Hod_Dashboard/HOD_ApprovedSchools" asp-route-currentPage="@(Model.CurrentPage - 1)"
                                   class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                    <span class="sr-only">Previous</span>
                                    <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                                    </svg>
                                </a>
                            }

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <a asp-page="/Hod_Dashboard/HOD_ApprovedSchools" asp-route-currentPage="@i"
                                   class="relative inline-flex items-center px-4 py-2 border @(i == Model.CurrentPage ? "border-indigo-500 bg-indigo-50 text-indigo-600" : "border-gray-300 bg-white text-gray-700") text-sm font-medium hover:bg-gray-50">
                                    @i
                                </a>
                            }

                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <a asp-page="/Hod_Dashboard/HOD_ApprovedSchools" asp-route-currentPage="@(Model.CurrentPage + 1)"
                                   class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                    <span class="sr-only">Next</span>
                                    <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                                    </svg>
                                </a>
                            }
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const tradeFilter = document.getElementById('tradeFilter');
            const rows = document.querySelectorAll('.school-row');

            function filterTable() {
                const searchTerm = searchInput.value.toLowerCase();
                const selectedTrade = tradeFilter.value;

                rows.forEach(row => {
                    const institutionName = row.getAttribute('data-name').toLowerCase();
                    const email = row.getAttribute('data-email').toLowerCase();
                    const trade = row.getAttribute('data-trade');

                    const matchesSearch = institutionName.includes(searchTerm) || email.includes(searchTerm);
                    const matchesTrade = !selectedTrade || trade === selectedTrade;

                    if (matchesSearch && matchesTrade) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            searchInput.addEventListener('input', filterTable);
            tradeFilter.addEventListener('change', filterTable);
        });
    </script>
}