@page
@model AccreditationSystem.Pages.Hod_Dashboard.ApplicationsModel
@{
    var statusClasses = new Dictionary<string, string>
    {
        { "Pending", "bg-blue-100 text-blue-800" },
        { "Approved", "bg-green-100 text-green-800" },
        { "Rejected", "bg-red-100 text-red-800" },
        { "Draft", "bg-gray-100 text-gray-800" },
        { "In Progress", "bg-yellow-100 text-yellow-800" }
    };
}

<div class="w-full min-h-screen bg-gray-50">
    <!-- Header/Navigation Bar -->
    <header class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <!-- Logo -->
                <div class="flex items-center flex-shrink-0">
                    <a href="#" class="text-indigo-600 font-bold text-xl">Accreditation</a>
                </div>

                <!-- Center Navigation -->
                <nav class="hidden md:flex space-x-8 items-center">
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_HOME" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Home</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Applications" class="text-indigo-600 border-b-2 border-indigo-600  px-3 py-2 text-sm font-medium">Applications</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Schools" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Schools</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Inspections" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Inspections</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Claims" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Claims</a>
                </nav>

                <!-- User menu -->
                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-2">
                        <span class="bg-gray-200 text-gray-700 rounded-full h-8 w-8 flex items-center justify-center text-sm font-medium">JK</span>
                        <span class="text-gray-700 font-medium">HOD</span>
                    </div>
                    <button class="bg-red-500 hover:bg-red-300 text-black font-semibold py-2 text-white px-4 border border-gray-300 rounded shadow-sm text-sm">
                        <a href="/">Sign out</a>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <main class="w-full mx-auto py-6 sm:px-6 lg:px-8">
        <!-- Applications Management Section -->
        <div class="mt-6">
            <div class="sm:flex sm:items-center">
                <div class="sm:flex-auto">
                    <h3 class="text-xl font-semibold text-gray-900">Manage Applications</h3>
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="mt-2 p-2 bg-red-100 text-red-700 rounded">
                            @TempData["ErrorMessage"]
                        </div>
                    }
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="mt-2 p-2 bg-green-100 text-green-700 rounded">
                            @TempData["SuccessMessage"]
                        </div>
                    }
                </div>
                <div class="mt-4 sm:mt-0 sm:flex sm:items-center">
                    <div>
                        <select id="tradeFilter" onchange="filterApplications()" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                            <option value="">All Trades</option>
                            @{
                                var uniqueTrades = Model.Applications
                                .Select(a => a.Trade)
                                .Distinct()
                                .OrderBy(t => t);

                                foreach (var trade in uniqueTrades)
                                {
                                    <option value="@trade">@trade</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="mt-3 flex flex-col">
                <div class="-my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
                    <div class="py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8">
                        <div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            Institution
                                        </th>
                                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            Trade
                                        </th>
                                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            Email
                                        </th>
                                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            Contact
                                        </th>
                                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            Status
                                        </th>
                                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            Actions
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="applicationsTableBody" class="bg-white divide-y divide-gray-200">
                                    @foreach (var app in Model.Applications)
                                    {
                                        <tr class="application-row" data-trade="@app.Trade">
                                            <td class="px-6 py-2 whitespace-nowrap">
                                                <div class="flex items-center">
                                                    <div class="ml-4">
                                                        <div class="text-sm font-medium text-gray-900">@app.InstitutionName</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="px-6 py-2 whitespace-nowrap">
                                                <div class="text-sm text-gray-900">@app.Trade</div>
                                            </td>
                                            <td class="px-6 py-2 whitespace-nowrap">
                                                <div class="text-sm text-gray-900">@app.Email</div>
                                            </td>
                                            <td class="px-6 py-2 whitespace-nowrap">
                                                <div class="text-sm text-gray-900">@(string.IsNullOrEmpty(app.ContactPerson) ? "N/A" : app.ContactPerson)</div>
                                            </td>
                                            <td class="px-6 py-2 whitespace-nowrap">
                                                @{
                                                    string statusClass = statusClasses.ContainsKey(app.Status)
                                                    ? statusClasses[app.Status]
                                                    : "bg-gray-100 text-gray-800";
                                                }
                                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @statusClass">
                                                    @app.Status
                                                </span>
                                            </td>
                                            <td class="px-6 py-2 whitespace-nowrap text-sm text-gray-500">
                                                <button onclick="openEditModal('@app.ID', '@app.Email', '@app.Trade', '@app.Status')" class="text-indigo-600 hover:text-indigo-900">Edit</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pagination (Update with actual pagination logic) -->
            <div class="mt-5 flex items-center justify-between">
                <div class="flex-1 flex justify-between sm:hidden">
                    <a href="#" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                        Previous
                    </a>
                    <a href="#" class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                        Next
                    </a>
                </div>
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-gray-700">
                            Showing <span class="font-medium">@Model.Applications.Count</span> results
                        </p>
                    </div>
                    <!-- Add pagination controls if needed -->
                </div>
            </div>
        </div>
    </main>

    <!-- Edit Modal (Updated to include application ID) -->
    <!-- Edit Modal with Form Post -->
    <div id="editModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
        <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
            <div class="flex flex-col">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-lg font-medium text-gray-900">Edit Application</h3>
                    <button type="button" onclick="closeEditModal()" class="text-gray-400 hover:text-gray-500">
                        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <form method="post">
                    <input type="hidden" id="applicationId" name="ApplicationId" />

                    <div class="mb-4">
                        <label class="block text-gray-700 text-sm font-bold mb-2" for="email">
                            Email
                        </label>
                        <input id="email" name="Email" type="text" readonly class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline bg-gray-100">
                    </div>

                    <div class="mb-4">
                        <label class="block text-gray-700 text-sm font-bold mb-2" for="trade">
                            Trade
                        </label>
                        <input id="trade" name="Trade" type="text" readonly class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline bg-gray-100">
                    </div>

                    <div class="mb-6">
                        <label class="block text-gray-700 text-sm font-bold mb-2" for="status">
                            Status
                        </label>
                        <select id="status" name="Status" class="shadow border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                            <option value="Pending">Pending</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                            <option value="Draft">Draft</option>
                            <option value="In Progress">In Progress</option>
                        </select>
                    </div>

                    <div class="flex justify-end space-x-2">
                        <button type="button" onclick="closeEditModal()" class="px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300 focus:outline-none">
                            Cancel
                        </button>
                        <button type="submit" asp-page-handler="UpdateStatus" class="px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700 focus:outline-none">
                            Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Function to open the edit modal and populate it with data
       // Function to open the edit modal and populate it with data
    function openEditModal(id, email, trade, status) {
        document.getElementById('applicationId').value = id;
        document.getElementById('email').value = email;
        document.getElementById('trade').value = trade;
        document.getElementById('status').value = status;
        document.getElementById('editModal').classList.remove('hidden');
    }

    // Function to close the edit modal
    function closeEditModal() {
        document.getElementById('editModal').classList.add('hidden');
    }

    // Close the modal if user clicks outside of it
    window.onclick = function(event) {
        const modal = document.getElementById('editModal');
        if (event.target === modal) {
            closeEditModal();
        }
    }

    // Filter applications by trade
    function filterApplications() {
        const tradeFilter = document.getElementById('tradeFilter').value;
        const rows = document.querySelectorAll('.application-row');

        rows.forEach(row => {
            if (tradeFilter === '' || row.dataset.trade === tradeFilter) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    // Close the modal if user clicks outside of it
    window.onclick = function(event) {
        const modal = document.getElementById('editModal');
        if (event.target === modal) {
            closeEditModal();
        }
    }
</script>