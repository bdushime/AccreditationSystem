@page
@model AccreditationSystem.Pages.Hod_Dashboard.ClaimsModel
@{
    ViewData["Title"] = "Claims - Accreditation System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Include Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
    <!-- Header/Navigation Bar -->
    <header class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <!-- Logo -->
                <div class="flex items-center flex-shrink-0">
                    <a href="#" class="text-indigo-600 font-bold text-xl">Accreditation</a>
                </div>

                <!-- Center Navigation -->
                <nav class="hidden md:flex space-x-8 items-center">
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_HOME" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Home</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Applications" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Applications</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Schools" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Schools</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Inspections" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Inspections</a>
                    <a asp-area="" asp-page="/Hod_Dashboard/HOD_Claims" class="text-indigo-600 border-b-2 border-indigo-600 px-3 py-2 text-sm font-medium">Claims</a>
                </nav>

                <!-- User menu -->
                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-2">
                        <span class="bg-gray-200 text-gray-700 rounded-full h-8 w-8 flex items-center justify-center text-sm font-medium">JK</span>
                        <span class="text-gray-700 font-medium">HOD</span>
                    </div>
                    <button class="bg-red-500 hover:bg-red-300 text-black font-semibold py-2 text-white px-4 border border-gray-300 rounded shadow-sm text-sm">
                        <a href="/">Sign out</a>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
        <!-- Header Section with Search and Filter -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-900 mb-4 md:mb-0">List Of Claims</h1>

            @* <div class="flex flex-col md:flex-row w-full md:w-auto space-y-4 md:space-y-0 md:space-x-4"> *@
            @*     <!-- Filter Dropdown --> *@
            @*     <div class="relative w-full md:w-48"> *@
            @*         <select class="block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md"> *@
            @*             <option>Choose service</option> *@
            @*             <option>TVET TRADES</option> *@
            @*             <option>Primary Level</option> *@
            @*             <option>Secondary School</option> *@
            @*         </select> *@
            @*     </div> *@
            @* </div> *@
        </div>

        <!-- Error Message Display -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert">
                <span class="block sm:inline">@TempData["ErrorMessage"]</span>
            </div>
        }

        <!-- Claims Table -->
        <div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider cursor-pointer">
                            <div class="flex items-center">
                                Profile
                                <svg class="ml-1 w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                </svg>
                            </div>
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Service
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Message
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Phone
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Status
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @if (Model.Applications.Count > 0)
                    {
                        @foreach (var claim in Model.Applications)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="ml-4">
                                            <div class="text-sm font-medium text-gray-900">@claim.SchoolEmail</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900">@claim.AccreditationType</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900">@(claim.AdditionalComments ?? "No comments")</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900">@claim.ContactPhone</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @{
                                        string statusColorClass = "bg-blue-100 text-blue-800";
                                        if (claim.Status == "Approved")
                                        {
                                            statusColorClass = "bg-green-100 text-green-800";
                                        }
                                        else if (claim.Status == "Rejected")
                                        {
                                            statusColorClass = "bg-red-100 text-red-800";
                                        }
                                        else if (claim.Status == "Submitted")
                                        {
                                            statusColorClass = "bg-yellow-100 text-yellow-800";
                                        }
                                    }
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @statusColorClass">
                                        • @claim.Status
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <a href="/Hod_Dashboard/ClaimDetail?id=@claim.ClaimID" class="bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold py-1 px-3 border border-gray-300 rounded shadow-sm text-sm">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-4 text-center text-sm text-gray-500">
                                No claims found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="mt-5 flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-700">
                    Show <span class="font-medium">@(Model.Applications.Count)</span> of <span class="font-medium">@(Model.Applications.Count)</span>
                </p>
            </div>
            <div class="flex items-center space-x-2">
                <button class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    <svg class="h-5 w-5 mr-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    Prev
                </button>
                <div class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white">
                    1
                </div>
                <button class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    Next
                    <svg class="h-5 w-5 ml-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
        </div>
    </main>
</body>
</html>