<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Accreditation System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .top-nav {
            background-color: #1550a6;
            padding: 0.5rem 1rem;
        }

        .top-nav a {
            color: white;
            text-decoration: none;
        }

        .btn-login {
            background-color: white;
            color: #1550a6;
            border-radius: 20px;
            padding: 0.25rem 1.5rem;
            font-weight: 500;
        }

        .footer {
            background-color: #f8f9fa;
            padding: 2rem 0;
            margin-top: 3rem;
        }
    </style>
</head>
<body>
    <header>
        <div class="top-nav d-flex justify-content-between align-items-center">
            <a href="/" class="text-white">Accreditation</a>
            <div>
                <a href="/" class="me-3">Home</a>
                <a href="/Auth/Register" class="btn btn-login">Register</a>
                <a href="/Auth/Login" class="btn btn-login">Login</a>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer text-muted">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <p>&copy; 2025 - Accreditation System - All rights reserved</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <ul class="list-inline mb-0">
                        <li class="list-inline-item"><a asp-area="" asp-page="/Privacy">Privacy</a></li>
                        <li class="list-inline-item"><a asp-area="" asp-page="/Terms">Terms</a></li>
                        <li class="list-inline-item"><a asp-area="" asp-page="/Contact">Contact</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>