                    </svg>
                </div>
                <h3 class="text-xl font-bold text-center mb-4">TVET Trades</h3>
                <p class="text-gray-600 mb-6 text-center">
                    Register for Technical and Vocational Education and Training accreditation to ensure your programs meet industry-specific standards.
                </p>
                <div class="text-center">
                    <a href="/Admin/TVETTrades" class="inline-block px-6 py-3 bg-primary-600 text-white font-medium rounded-md hover:bg-primary-700 transition duration-300">
                        Request TVET Program
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Second Row of Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 4 -->
        <div class="bg-white rounded-lg shadow-lg overflow-hidden transition-transform duration-300 hover:shadow-xl hover:-translate-y-1">
            <div class="p-6">
                <div class="w-16 h-16 mx-auto mb-6 flex items-center justify-center bg-primary-100 text-primary-700 rounded-full">
