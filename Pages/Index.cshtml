        <div class="flex justify-center space-x-4">
            <a href="/register" class="px-8 py-4 bg-white text-primary-700 font-bold rounded-md hover:bg-gray-100 transition duration-300 shadow-lg">Get Started Today</a>
            <a href="/contact" class="px-8 py-4 bg-transparent border-2 border-white text-white font-bold rounded-md hover:bg-white/10 transition duration-300">Contact Us</a>
        </div>
    </div>
</div>

